---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Gallery from "../components/Gallery.astro";
---

<Layout
  title="Josh Rehders — Concert and Sports Photographer & Videographer"
  description="Josh Rehders is a concert and sports photographer & videographer based in New York City."
>

  <main>  
    <Header />
    <div class="about-container">
      <object
        data="/rehders_resume.pdf"
        type="application/pdf"
        width="80%"
        height="800px"
      >
        <p>Your browser doesn't support PDF embedding. <a href="/resume.pdf">Download the resume</a> instead.</p>
      </object>
    </div>
  </main>

</Layout>