	  element.style.transition = "all 200ms ease-in-out";
	  element.style.width = tileRect.width + "px";
	  element.style.height = tileRect.height + "px";
	  element.style.top = tileRect.top + "px";
	  element.style.left = tileRect.left + "px";
  
