---
import GA from '../components/analytics/GA.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  hidden?: boolean;
}

const { title, description, hidden = false } = Astro.props;
const share_image = "https://res.cloudinary.com/ddsnvfih0/image/upload/v1730050128/social.jpg";

const prod = import.meta.env.PROD;
const dev = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={`${hidden ? "noindex" : "all"}`}>
    <link rel="icon" type="image/png" href="https://res.cloudinary.com/ddsnvfih0/image/upload/v1736227309/logo_zde1ld.svg"/>

    <!-- <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌉</text></svg>" /> -->
    <!-- <link rel="preload" href="/fonts/subset-OpenSans-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/subset-OpenSans-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/subset-OpenSans-SemiBold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/subset-OpenSans-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/subset-OpenSans-ExtraBold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/subset-OpenSans-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/subset-OpenSans-MediumItalic.woff2" as="font" type="font/woff2" crossorigin="anonymous" /> -->

    <link rel="stylesheet" href="https://use.typekit.net/cwk1pao.css">

    <title>{title}</title>

    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Josh Rehders" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:description" content={description} />

    <meta property="og:image" content={share_image} />
    <meta property="og:image:url" content={share_image} />
    <meta property="og:image:secure_url" content={share_image} />
    <meta property="og:type" content="image/jpeg" />
    <meta property="og:image:width" content="2160" />
    <meta property="og:image:height" content="1080" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@joshrehders" />
    <meta name="twitter:creator" content="@joshrehders" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share_image} />
    <meta name="twitter:image:alt" content="Josh Rehders is a concert and sports photographer based in New York City." />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5Y13N2RH7S" type="text/partytown"></script>
    <script
    is:inline
    type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
            dataLayer.push(arguments);
        };
      window.gtag('js', new Date());
      window.gtag('config', 'G-5Y13N2RH7S', {
    page_path: window.location.pathname,
    page_title: document.title,
    referrer: document.referrer
  });
    </script>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KCWFSGKB');</script>
      <!-- End Google Tag Manager -->
  </head>

  <body class="bg-slate-100 text-neutral-900 dark:bg-neutral-900 dark:text-slate-100">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KCWFSGKB"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      const referrer = document.referrer;
      console.log('Referrer:', referrer);
      window.dataLayer.push({
        event: 'pageview',
        page_path: window.location.pathname,
        page_title: document.title,
        referrer: referrer
      });
    </script>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-Regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-Medium.woff2") format("woff2");
    font-style: normal;
    font-weight: 500;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-SemiBold.woff2") format("woff2");
    font-style: normal;
    font-weight: 600;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-Bold.woff2") format("woff2");
    font-style: normal;
    font-weight: 700;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-ExtraBold.woff2") format("woff2");
    font-style: normal;
    font-weight: 800;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-Italic.woff2") format("woff2");
    font-style: italic;
    font-weight: 400;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Open Sans";
    src: url("/fonts/subset-OpenSans-MediumItalic.woff2") format("woff2");
    font-style: italic;
    font-weight: 500;
    font-display: optional;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  .about-container {  
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background-color: rgb(23,23,23);
    color: #ffffff;
    font-family: "proxima-nova", sans-serif;
    flex-direction: column;
  }

  .about-text > div {
    max-width: 800px;
    margin: 0 auto;
  }

  /* Mobile: contact info first, then text, then photo */
  .contact-info-mobile {
    display: block;
    order: 1;
    text-align: left;
    max-width: 800px;
  }

  .about-text {
    order: 2;
    width: 100%;
  }

  .sidebar {
    order: 3;
    width: 100%;
  }

  .contact-info-desktop {
    display: none;
    text-align: left;
  }

  /* Desktop: text on left, contact info + photo on right */
  @media (min-width: 601px) {
    .about-container {
      flex-direction: row;
      gap: 2rem;
      align-items: flex-start !important;
    }

    .contact-info-mobile {
      display: none;
    }

    .about-text {
      flex: 1;
      order: 1;
    }

    .sidebar {
      flex: 0 0 auto;
      order: 2;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 30%;
      width: auto;
    }

    .contact-info-desktop {
      display: block;
      margin: 0;
    }

    .sidebar .profpic {
      margin: 0 !important;
      max-width: 100%;
    }

    .sidebar .profpic img {
      width: 100%;
      height: auto;
    }
  }

  .about-container div a {
    color: #9395CC;
    text-decoration: none;
    font-weight: 300;
  }

  .about-container div a:hover {
    color: #505050; /* Adjust color to match the hover state */
  }

  .about-container div span {
    font-size: 20px;
  }

  .about-container div span a {
    color: #9395CC;
    text-decoration: none;
    font-weight: 300;
  }

  .about-container div span a:hover {
    color: #505050; /* Adjust color to match the hover state */
  }

  .about-container div p {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .about-container div p.client-list {
    color: #aaa
  }

  ::-webkit-scrollbar {
    @apply w-4;
  }

  ::-webkit-scrollbar-track {
    @apply bg-slate-100 dark:bg-neutral-900;
  }

  ::-webkit-scrollbar-thumb {
    @apply rounded-full border-4 border-solid border-slate-100 bg-neutral-400 opacity-50 dark:border-neutral-900 dark:bg-neutral-600;
  }

  .text-xs{
    font-size: 0.75rem;
    font-family: "proxima-nova", sans-serif;
  }

  .header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background-color: rgb(23,23,23);
  color: #ffffff;
  font-family: "proxima-nova", sans-serif;
}

.header-left h1 {
  font-size: 20px;
  margin: 0;
  margin-bottom: -4px;
  font-weight: 600;
}

.header-left p {
  font-size: 20px;
  color: #8b8b8b
}

.header-left a:hover {
  color: #505050; /* Adjust color to match the hover state */
}

.header-left p a {
  color: #8b8b8b;
  text-decoration: none;
  font-weight: 300;
}

.header-left p a:hover {
  color: #505050; /* Adjust color to match the hover state */
}

.header-nav {
  display: flex;
  align-items: center;
}

.header-link {
  color: #8b8b8b;
  margin-right: 1rem;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}

.header-link:hover {
  color: #fff; /* Adjust color to match the hover state */
}

.header-link-active {
  margin-right: 1rem;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  color: #9395CC;
}

.header-icons {
  display: flex;
  align-items: center;
}

.header-icon {
  margin-left: 10px;
  fill: #8b8b8b;
  font-size: 18px;
}

.header-icon:hover {
  fill: #fff; /* Adjust color to match the hover state */
}

/* Media query for smaller screens */
@media (max-width: 768px) {
  .header {
    flex-direction: column;
    align-items: flex-start;
  }

  .header-nav {
    width: 100%;
    margin-top: 1rem;
    flex-direction: row;
  }

  .header-link {
    margin-right: 0.5rem;
  }

  .header-link-active {
    margin-right: 0.5rem;
  }

  .header-icons {
    display: none !important;
  }


}

</style>
