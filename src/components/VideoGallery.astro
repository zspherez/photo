---
import { v2 as cloudinary } from "cloudinary";
import Icon from './Icon.astro';

export interface Props {
  folder: string; // Main folder with videos
  thumbnailFolder?: string; // Optional thumbnail folder
}

export interface CloudinaryResource {
  secure_url: string;
  resource_type: string;
  width: number;
  height: number;
  duration: number;
  aspect_ratio: number;
  context?: { alt?: string };
}

// Tiles beyond this index (DOM order) get their poster gated by data-poster/observer.
const EAGER_POSTER_COUNT = 4;

cloudinary.config({
  cloud_name: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME,
  api_key: import.meta.env.PUBLIC_CLOUDINARY_API_KEY,
  api_secret: import.meta.env.SECRET_CLOUDINARY_API_KEY,
  secure: true,
});

// Determine thumbnail folder name
const thumbnailFolderName = Astro.props.thumbnailFolder || `${Astro.props.folder}-thumbnails`;

// Fetch videos and thumbnails concurrently; the two searches are independent.
const [videoSearch, thumbnailSearch] = await Promise.all([
  cloudinary.search
    .expression(`folder:${Astro.props.folder} AND resource_type:video`)
    .with_field("context")
    .sort_by("display_name", "asc")
    .max_results(500)
    .execute(),
  cloudinary.search
    .expression(`folder:${thumbnailFolderName}`)
    .sort_by("display_name", "asc")
    .max_results(500)
    .execute(),
]);

const videos = videoSearch.resources as CloudinaryResource[];
const thumbnails = thumbnailSearch.resources as CloudinaryResource[];

// Create a mapping of video filenames to thumbnail URLs
const thumbnailMap = new Map<string, string>();
thumbnails.forEach(thumbnail => {
  // Extract full filename from URL
  const fullFilename = thumbnail.secure_url.split('/').pop() || '';
  // Split filename into name and extension
  const dotIndex = fullFilename.lastIndexOf('.');
  if (dotIndex > 7) {  // Make sure we have enough characters
    // Get the base name without the 7-char ID and extension
    const baseName = fullFilename.substring(0, dotIndex - 7);
    thumbnailMap.set(baseName, thumbnail.secure_url);
  }
});

// Helper function to optimize video URLs
function optimizeVideoUrl(url: string): string {
  if (url.includes('cloudinary.com')) {
    // Add video optimization parameters
    return url.replace('/upload/', '/upload/q_auto,vc_auto,f_auto/');
  }
  return url;
}

// Helper function to get the thumbnail URL for a video
function getThumbnailUrl(videoUrl: string): string {
  // Extract full filename from URL
  const fullFilename = videoUrl.split('/').pop() || '';
  // Split filename into name and extension
  const dotIndex = fullFilename.lastIndexOf('.');
  
  if (dotIndex > 7) {  // Make sure we have enough characters
    // Get the base name without the 7-char ID and extension
    const baseName = fullFilename.substring(0, dotIndex - 7);
    
    // Return the mapped thumbnail if available, otherwise fall back to default method
    if (thumbnailMap.has(baseName)) {
      // Cap width, aspect-preserving, no crop
      return thumbnailMap.get(baseName)!.replace('/upload/', '/upload/c_limit,w_1000,f_auto,q_auto/');
    }
  }
  
  // Fall back to default method if no match found
  const baseUrl = videoUrl.replace(".mp4", ".jpg");
  return baseUrl.replace('/upload/', '/upload/c_limit,w_1000,f_auto,q_auto/');
}
---

<div class="flex flex-wrap m-0.5" data-gallery-count={videos.length}>
  {videos.map((video, index) => {
    const isEager = index < EAGER_POSTER_COUNT;
    const posterUrl = getThumbnailUrl(video.secure_url);
    const label = video.context?.alt || `Play video ${index + 1}`;
    return (
    <div
      data-position={`${index == 0 ? "first" : index + 1 == videos.length ? "last" : "middle"}`}
      role="button"
      tabindex="0"
      aria-label={label}
      onclick="setFullscreen(this)"
      class="relative m-0.5 cursor-zoom-in fullscreen:cursor-auto"
      style={`flex-grow: ${video.width * 400 / video.height}; flex-basis: ${video.width * 400 / video.height}px;`}
    >
      <!-- placeholder for proper grid sizing -->
      <div class="block" style={`padding-bottom: ${video.height / video.width * 100}%`}></div>

      <div role="status" class="fullscreen:block fullscreen:fixed z-[2] absolute top-1/2 left-1/2 hidden -translate-x-1/2 -translate-y-1/2" style={isEager ? "display: none" : undefined}>
        <span data-video-spinner aria-hidden="true" class="block h-10 w-10 animate-spin rounded-full border-4 border-white/30 border-t-white"></span>
        <span data-video-error class="hidden rounded bg-black/70 px-3 py-2 text-sm text-white">Video unavailable</span>
        <span data-video-status-text class="sr-only">Loading video...</span>
      </div>

      <div>
        <video
          id={`video-${index}`}
          loop webkit-playsinline playsinline
          preload="none"
          onclick="toggleVideoPlayback(this)"
          data-poster={posterUrl}
          poster={isEager ? posterUrl : undefined}
          class={`resource absolute top-0 h-full w-full object-cover align-bottom pointer-events-none fullscreen:pointer-events-auto ${isEager ? "opacity-100" : "opacity-0 transition-opacity ease-in duration-1000"}`}
        >
          <source src={optimizeVideoUrl(video.secure_url)} type="video/mp4" />
          Your browser does not support HTML video.
        </video>
      </div>

      <div class="video-duration pointer-events-none fullscreen:pl-6 fullscreen:pb-6 fullscreen:z-[2] fullscreen:left-0 fullscreen:fixed absolute bottom-0 flex w-full items-center justify-start bg-gradient-to-t from-black/50 to-transparent font-mono">
        <span class="fullscreen:hidden"><Icon name="play" /></span>
        <div class="text-xs">
          <span id={`current-time-video-${index}`} class="current-time hidden fullscreen:inline-flex">0:00 / </span>
          <span>{new Date(video.duration * 1000).toISOString().slice(15, 19)}</span>
        </div>
      </div>
    </div>
    );
  })}
</div>

<div id="fullscreen-backdrop" class="fixed scale-200 inset-0 z-[1] w-screen h-screen bg-black pointer-events-none opacity-0 transition-opacity duration-200"></div>

<!-- Replace your existing empty fullscreen-controls div with this -->
<div id="fullscreen-controls" role="dialog" aria-modal="true" aria-label="Video viewer" aria-hidden="true" class="fixed top-0 z-[3] w-screen h-screen pointer-events-none opacity-0 transition-opacity duration-200">
	<button type="button" onclick="prevResource()" tabindex="-1" class="fixed left-0 mt-[25vh] flex h-[50vh] w-[15vw] items-center opacity-0 hover:opacity-100 focus-visible:opacity-100 md:w-[25vw]">
	  <div class="absolute left-0 ml-4 rounded-full bg-neutral-700 p-2 md:ml-8 md:p-4">
		<Icon name="left" />
		<span class="sr-only">previous video</span>
	  </div>
	</button>
  
	<button type="button" onclick="nextResource()" tabindex="-1" class="fixed right-0 mt-[25vh] flex h-[50vh] w-[15vw] items-center opacity-0 hover:opacity-100 focus-visible:opacity-100 md:w-[25vw]">
	  <div class="absolute right-0 mr-4 rounded-full bg-neutral-700 p-2 md:mr-8 md:p-4">
		<Icon name="right" />
		<span class="sr-only">next video</span>
	  </div>
	</button>

	<div class="fixed bottom-0 right-0 z-[3] mb-4 mr-4 flex gap-2">
	  <button type="button" id="fullscreen-play-btn" onclick="toggleVideoPlayback(getFullscreenVideo())" tabindex="-1" aria-label="Pause video" class="rounded-full bg-neutral-700/50 p-3 hover:bg-neutral-700">
		<span data-icon="pause"><Icon name="pause" /></span>
		<span data-icon="play" class="hidden"><Icon name="play" /></span>
	  </button>

	  <button type="button" id="fullscreen-mute-btn" onclick="toggleFullscreenMute()" tabindex="-1" aria-label="Mute video" class="rounded-full bg-neutral-700/50 p-3 hover:bg-neutral-700">
		<span data-icon="volume"><Icon name="volume" /></span>
		<span data-icon="muted" class="hidden"><Icon name="muted" /></span>
	  </button>
	</div>
  
	<button type="button" id="fullscreen-close-btn" onclick="escapeFullscreen(true)" tabindex="-1" class="fixed ml-2 mt-2 rounded-full bg-neutral-700/50 p-3 hover:bg-neutral-700">
	  <Icon name="x" />
	  <span class="sr-only">exit video</span>
	</button>
  </div>

<!-- Gate offscreen poster fetches and reveal tiles as they near the viewport -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
	  const videoElements = document.querySelectorAll("video");
	  // Cache in-flight/completed poster loads so tiles sharing a URL share one fetch.
	  interface PosterCacheEntry {
		settled: boolean;
		ok: boolean;
		listeners: Array<(ok: boolean) => void>;
	  }
	  const posterCache = new Map<string, PosterCacheEntry>();

	  function loadPoster(url: string, onDone: (ok: boolean) => void): void {
		const cached = posterCache.get(url);
		if (cached) {
		  cached.settled ? onDone(cached.ok) : cached.listeners.push(onDone);
		  return;
		}
		const entry: PosterCacheEntry = { settled: false, ok: false, listeners: [onDone] };
		const settle = (ok: boolean) => {
		  entry.settled = true;
		  entry.ok = ok;
		  entry.listeners.forEach((cb) => cb(ok));
		  entry.listeners = [];
		};
		const img = new Image();
		img.onload = () => settle(true);
		img.onerror = () => settle(false);
		img.src = url;
		posterCache.set(url, entry);
	  }

	  function revealPoster(video: HTMLVideoElement, loadingIndicator: HTMLElement | null, posterUrl: string | null): void {
		const tile = video.closest("[data-position]");
		if (tile?.id === "fullscreen" || tile?.getAttribute("data-opening") === "true") {
		  return;
		}
		if (posterUrl) {
		  video.poster = posterUrl;
		}
		video.style.opacity = "1";
		if (loadingIndicator) {
		  loadingIndicator.style.display = "none";
		}
	  }

	  // Widened rootMargin so fast mobile scrolling doesn't outrun the fetch.
	  const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
		  if (!entry.isIntersecting) return;

		  const video = entry.target;
		  if (!(video instanceof HTMLVideoElement)) return;
		  observer.unobserve(video);

		  const sibling = video.parentElement?.previousElementSibling;
		  const loadingIndicator = sibling instanceof HTMLElement ? sibling : null;
		  const posterUrl = video.dataset.poster;

		  // Eager tiles already carry a server-rendered poster; just tidy state.
		  if (video.getAttribute("poster") || !posterUrl) {
			revealPoster(video, loadingIndicator, null);
			return;
		  }

		  // Wait for poster bytes; reveal without one on failure rather than staying stuck.
		  loadPoster(posterUrl, (ok) => revealPoster(video, loadingIndicator, ok ? posterUrl : null));
		});
	  }, {
		rootMargin: "300px"
	  });

	  videoElements.forEach(video => observer.observe(video));
	});
  </script>
  
<!-- Add this right before the existing script tag or combine with it -->
<script is:inline>
	let isAnimating = false;
	// Set when a close is requested mid-animation; serviced once the current animation settles.
	let pendingClose = false;
	// Set only while a frame wait is in flight (before geometry starts); lets Escape abort outright.
	let pendingOpen = null;
	// Tile that opened the lightbox, so focus can return to it on close.
	let openerElement = null;
	// User's mute choice, carried across fullscreen opens/slides until they change it.
	let fullscreenMuted = false;
	// Active prev/next slide controller (incoming prep + transition), or null when idle.
	let slideState = null;
	// Net direction of arrow/swipe inputs coalesced during a transition; drained after settle.
	let queuedNav = 0;
	// Bounds the first-frame wait so a stalled/blocked video never holds the animation open.
	// Generous enough to avoid a premature no-frame fallback on a slow direct open.
	const FRAME_READY_TIMEOUT_MS = 750;
	// One simultaneous incoming/outgoing transition, kept in a snappy 180-220ms window.
	const SLIDE_DURATION_MS = 200;
	// Lets prev/next/slide no-op for 0/1-video galleries.
	const galleryCount = Number(document.querySelector("[data-gallery-count]")?.dataset.galleryCount || 0);

	function getFullscreenVideo() {
	  const fullscreen = document.getElementById("fullscreen");
	  return fullscreen ? fullscreen.querySelector("video") : null;
	}

	function toggleFullscreenMute() {
	  const video = getFullscreenVideo();
	  if (!video) return;
	  video.muted = !video.muted;
	  fullscreenMuted = video.muted; // volumechange listener syncs the button UI
	}

	// Resolves onReady(hasFrame) once a real frame is decoded/renderable, or after a bounded
	// timeout (hasFrame=false). timeoutMs defaults to the generous direct-open budget; slides pass a
	// short budget so a stalled incoming falls back to its restored poster fast instead of hanging.
	// Returns { finish, cancel }: finish(hasFrame) force-resolves early (e.g. play() rejects),
	// cancel aborts without ever calling onReady (escaped mid-wait).
	function waitForFirstFrame(video, onReady, timeoutMs = FRAME_READY_TIMEOUT_MS) {
	  let settled = false;
	  let rvfcHandle = null;
	  let timeoutFrame = null;
	  let timeoutId = null;
	  // rVFC is the authoritative "frame actually painted" signal; when it exists, canplay
	  // reliably fires first and would start geometry before a frame is real, so don't race it.
	  const hasRVFC = typeof video.requestVideoFrameCallback === "function";

	  function onFrameEvent() {
		finish(true);
	  }

	  function onTimeout() {
		finish(false);
	  }

	  function cleanup() {
		if (timeoutId !== null) clearTimeout(timeoutId);
		if (timeoutFrame !== null) cancelAnimationFrame(timeoutFrame);
		if (rvfcHandle !== null && typeof video.cancelVideoFrameCallback === "function") {
		  video.cancelVideoFrameCallback(rvfcHandle);
		}
		video.removeEventListener("playing", onFrameEvent);
		video.removeEventListener("canplay", onFrameEvent);
		video.removeEventListener("loadeddata", onFrameEvent);
	  }

	  function finish(hasFrame) {
		if (settled) return;
		settled = true;
		cleanup();
		onReady(hasFrame);
	  }

	  function cancel() {
		if (settled) return;
		settled = true; // blocks any stale rVFC/event/timeout callback from firing late
		cleanup();
	  }

	  // Drive the visual deadline from rAF as well as setTimeout. Browsers can clamp media-related
	  // timers past a second while still rendering frames, which made a 90ms slide budget stutter.
	  const deadline = performance.now() + timeoutMs;
	  function checkVisualDeadline(now) {
		if (now >= deadline) onTimeout();
		else timeoutFrame = requestAnimationFrame(checkVisualDeadline);
	  }
	  timeoutFrame = requestAnimationFrame(checkVisualDeadline);
	  timeoutId = setTimeout(onTimeout, timeoutMs);

	  // Already has a paintable frame (e.g. warmed up by a hover preview).
	  if (video.readyState >= 2) {
		finish(true);
		return { finish, cancel };
	  }

	  if (hasRVFC) {
		rvfcHandle = video.requestVideoFrameCallback(onFrameEvent);
	  } else {
		video.addEventListener("playing", onFrameEvent, { once: true });
		video.addEventListener("canplay", onFrameEvent, { once: true });
		video.addEventListener("loadeddata", onFrameEvent, { once: true });
	  }

	  return { finish, cancel };
	}

	// Neighbor tiles bumped to preload="auto" so the immediate prev/next are frame-ready; bounded to 2.
	let preloadedNeighbors = [];

	function getNeighborTiles(element) {
	  const prev = element.dataset.position === "first"
		? document.querySelector("[data-position='last']")
		: element.previousElementSibling;
	  const next = element.dataset.position === "last"
		? document.querySelector("[data-position='first']")
		: element.nextElementSibling;
	  // De-dupe: in a 2-tile gallery, "prev" and "next" both wrap to the same tile.
	  return [...new Set([prev, next].filter((tile) => tile && tile !== element))];
	}

	function clearNeighborPreload(exempt) {
	  preloadedNeighbors.forEach((tile) => {
		// Skip the tile becoming current, and any tile mid hover-preview.
		if (tile === exempt) return;
		const video = tile.querySelector("video");
		if (video && video.paused && video.preload !== "none") {
		  video.preload = "none";
		  // Release after the transition handoff. A synchronous load() here made rapid arrows
		  // tear down media on the critical rendering path, and could reload the same neighbor.
		  const release = () => {
			if (
			  tile.id === "fullscreen"
			  || tile.getAttribute("data-opening") === "true"
			  || preloadedNeighbors.includes(tile)
			) {
			  return;
			}
			if (video.paused && video.preload === "none") video.load();
		  };
		  if (typeof window.requestIdleCallback === "function") {
			window.requestIdleCallback(release, { timeout: 500 });
		  } else {
			setTimeout(release, 0);
		  }
		}
	  });
	  preloadedNeighbors = [];
	}

	function preloadNeighborTiles(element) {
	  // Exempt: it may already be a neighbor, and clearing would abort its buffer pre-play.
	  clearNeighborPreload(element);
	  preloadedNeighbors = getNeighborTiles(element);
	  preloadedNeighbors.forEach((tile) => {
		const video = tile.querySelector("video");
		if (video && video.preload === "none") {
		  video.preload = "auto";
		  video.load(); // re-trigger resource selection under the new preload hint
		}
	  });
	}

	function setFullscreen(element) {
	  // ignore opens while already fullscreen or an animation is still in flight
	  if (element.id == "fullscreen" || isAnimating) {
		return;
	  }

	  // Return focus to the video the user is currently viewing, including after slides.
	  openerElement = element;

	  disableScrolling();
	  preloadNeighborTiles(element);
	  element.setAttribute("data-opening", "true");
  
	  const resource = element.querySelector(".resource");
	  const loadingIndicator = element.querySelector('[role="status"]');
	  const loadingSpinner = loadingIndicator?.querySelector("[data-video-spinner]");
	  const loadingError = loadingIndicator?.querySelector("[data-video-error]");
	  const loadingStatusText = loadingIndicator?.querySelector("[data-video-status-text]");
	  loadingSpinner?.classList.remove("hidden");
	  loadingError?.classList.add("hidden");
	  if (loadingStatusText) loadingStatusText.textContent = "Loading video...";
	  const loadingTimer = setTimeout(() => {
		if (loadingIndicator) loadingIndicator.style.display = "block";
	  }, 120);
	  if (
		resource.tagName === "VIDEO"
		&& !resource.getAttribute("poster")
		&& resource.dataset.poster
	  ) {
		resource.poster = resource.dataset.poster;
	  }

	  // Gate the visual open on a real frame so neither the poster nor a black frame flashes.
	  isAnimating = true;

	  let waitHandle = null;

	  function revealResourceImmediately() {
		resource.classList.remove("opacity-0", "transition-opacity", "ease-in", "duration-1000");
		resource.style.opacity = "1";
	  }

	  function beginVisualOpen(hasFrame) {
		pendingOpen = null; // geometry is committing now; no longer cancellable
		clearTimeout(loadingTimer);
		element.removeAttribute("data-opening");
		element.id = "fullscreen";
		enableFullscreenControls();
		document.getElementById("fullscreen-close-btn")?.focus();
		if (resource.tagName === "VIDEO" && resource.error) {
		  setFullscreenError(resource);
		} else if (loadingIndicator) {
		  loadingIndicator.style.display = hasFrame || resource.paused ? "none" : "block";
		}
		revealResourceImmediately();

		// Trust the evidence passed in, not a re-check: readyState can still read <2 even
		// though rVFC/frame events already proved a frame was decoded and painted.
		if (resource.tagName === "VIDEO" && hasFrame) {
		  resource.removeAttribute("poster");
		}
		if (resource.tagName === "VIDEO") {
		  if (hasFrame) resource.muted = fullscreenMuted;
		  updatePlayButtonUI(resource);
		  updateMuteButtonUI(resource);
		}

		zoomIn(resource);
	  }

	  // Aborts a still-pending open outright (no geometry ever ran) instead of queueing a close.
	  function cancelPendingOpen() {
		if (!pendingOpen) return;
		pendingOpen = null;
		if (waitHandle) waitHandle.cancel();
		clearTimeout(loadingTimer);
		element.removeAttribute("data-opening");
		if (loadingIndicator) loadingIndicator.style.display = "none";

		if (resource.tagName === "VIDEO") {
		  resource.pause();
		  resource.currentTime = 0;
		  resetVideoTimeDisplay(resource);
		  if (resource.dataset.poster) resource.poster = resource.dataset.poster;
		  resource.load(); // release whatever play() had begun fetching/decoding
		}
		revealResourceImmediately();

		clearNeighborPreload();
		element.removeAttribute("id");
		disableFullscreenControls();
		enableScrolling();
		document.getElementById("fullscreen-controls").querySelectorAll("button").forEach((button) => button.blur());
		isAnimating = false;
		pendingClose = false;
		queuedNav = 0;

		if (openerElement) {
		  openerElement.focus({ preventScroll: true });
		  openerElement = null;
		}
	  }

	  pendingOpen = { cancel: cancelPendingOpen };

	  if (resource.tagName === "VIDEO") {
		// Stay muted while waiting so audio cannot lead the visual transition.
		resource.muted = true;
		const playPromise = resource.play();
		if (playPromise && typeof playPromise.catch === "function") {
		  playPromise.catch(() => {
			if (isFullscreenVideo(resource)) updatePlayButtonUI(resource);
			if (resource.error) setFullscreenError(resource);
			if (waitHandle) waitHandle.finish(false); // no frame evidence; no point waiting out the timeout
			if (loadingIndicator && !resource.error) loadingIndicator.style.display = "none";
		  });
		}
		updatePlayButtonUI(resource);
		updateMuteButtonUI(resource);

		waitHandle = waitForFirstFrame(resource, beginVisualOpen);
	  } else {
		beginVisualOpen();
	  }
	}
  
	// Runs a deferred close once isAnimating settles, otherwise drains any coalesced navigation.
	function trySettleClose() {
	  if (pendingClose) {
		pendingClose = false;
		queuedNav = 0; // a close request wins over queued slides
		escapeFullscreen(true);
		return;
	  }
	  runQueuedNavigation();
	}

	function escapeFullscreen(close) {
	  if (close && pendingOpen) {
		// Geometry never started; abort outright instead of queueing it to run then immediately close.
		pendingOpen.cancel();
		return;
	  }

	  if (slideState) {
		// A slide owns the transition; a close must win by unwinding it cleanly.
		if (close) slideState.requestClose();
		return;
	  }

	  const fullscreen = document.getElementById("fullscreen");

	  if (!fullscreen) return;

	  if (isAnimating) {
		// Queue instead of dropping the request; trySettleClose fires it once settled.
		if (close) pendingClose = true;
		return;
	  }

	  const video = fullscreen.querySelector("video");
	  const loadingIndicator = fullscreen.querySelector('[role="status"]');
	  if (loadingIndicator) loadingIndicator.style.display = "none";
	  if (video && video.dataset.poster) {
		// Restore the thumbnail before the resource returns to the grid (slide or close).
		video.poster = video.dataset.poster;
	  }

	  if (close) {
		if (video) {
		  // Pause the video
		  video.pause();
		  
		  // Reset to the beginning to show the poster
		  video.currentTime = 0;
		  resetVideoTimeDisplay(video);
		  video.preload = "none";
		  
		  // Force poster to display
		  // This trick makes browsers show the poster again
		  video.load();
		}
		
		clearNeighborPreload();
		// Restore focus only once zoomOut's teardown actually finishes, not mid-animation.
		zoomOut(fullscreen.querySelector(".resource"), () => {
		  if (openerElement) {
			openerElement.focus({ preventScroll: true });
			openerElement = null;
		  }
		});
		disableFullscreenControls();
	  } else {
		if (video) {
		  // Slide-out needs the same repaint as close, or the tile freezes on its last frame.
		  video.pause();
		  video.currentTime = 0;
		  resetVideoTimeDisplay(video);
		  video.preload = "none"; // reset to grid baseline; preloadNeighborTiles re-raises it if still a neighbor
		  video.load();
		}

		resetElement(fullscreen.querySelector(".resource"))
	  }
	  
	  fullscreen.removeAttribute("id");
	
	  document.getElementById("fullscreen-controls").querySelectorAll("button").forEach((button) => button.blur());
	}

	function getAdjacentTile(tile, direction) {
	  if (direction > 0) {
		return tile.dataset.position === "last"
		  ? document.querySelector("[data-position='first']")
		  : tile.nextElementSibling;
	  }
	  return tile.dataset.position === "first"
		? document.querySelector("[data-position='last']")
		: tile.previousElementSibling;
	}

