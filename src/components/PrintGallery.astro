---
import Icon from "./Icon.astro";
import { buildImageUrl, getMediaFolder } from "../lib/media";
import {
  fetchPrintsViaRest,
  humanizePublicId,
  type PrintInfo,
  type PrintSize,
} from "../lib/prints";
import {
  calculateSizesMatchingAspectRatio,
  OTHER_SIZES_ENTRY,
  type PrintSpec,
} from "../lib/print-sizes";

export interface Props {
  folder?: string;
  /** Off by default — watermarking the enlarged image is a product decision pending sign-off. */
  watermarkEnlarged?: boolean;
}

const { folder = "prints", watermarkEnlarged = false } = Astro.props;
const resources = getMediaFolder(folder).filter((asset) => asset.type === "image");
const metadata = await fetchPrintsViaRest();
const GRID_WIDTH = 900;
const GRID_WIDTHS = [320, 480, 640, 900] as const;

/**
 * Build the display sizes for a photo.
 * Priority per size: per-image DB price > global default price > STANDARD_SIZES default price.
 * Always appends OTHER_SIZES_ENTRY at the end.
 */
function buildDisplaySizes(
  matchedSpecs: PrintSpec[],
  dbInfo: PrintInfo | undefined,
): PrintSize[] {
  const dbPriceMap = new Map((dbInfo?.sizes ?? []).map(s => [s.label, s.price]));

  const sized = matchedSpecs.map(spec => ({
    label: spec.label,
    price: dbPriceMap.get(spec.label) ?? spec.defaultPrice,
  }));

  return [...sized, OTHER_SIZES_ENTRY];
}

function priceSummary(sizes: PrintSize[]): string | null {
  // Skip the "Other sizes" entry for the summary
  const real = sizes.filter(s => s.price !== "Varies");
  if (!real.length) return null;
  return real.length === 1 ? real[0].price : `from ${real[0].price}`;
}

const items = await Promise.all(
  resources.map(async (r) => {
    const dbInfo   = metadata[r.publicId];
    const title    = dbInfo?.title || humanizePublicId(r.publicId);
    const description = dbInfo?.description || r.alt ||
      "Open-edition fine art print, signed on the reverse.";

    const matchedSpecs = calculateSizesMatchingAspectRatio(r.width, r.height);
    const displaySizes = buildDisplaySizes(matchedSpecs, dbInfo);

    // Fixed width ladder keeps every grid variant a pre-signed transformation.
    const gridLadder = GRID_WIDTHS.map((w) => ({
      w,
      url: buildImageUrl(r.key, `print-w-${w}`),
    }));
    const enlargedUrl = buildImageUrl(
      r.key,
      watermarkEnlarged ? "print-enlarged-watermarked" : "print-enlarged",
    );
    const gridSrcset = gridLadder.map(({ url, w }) => `${url} ${w}w`).join(", ");
    const gridUrl = gridLadder[gridLadder.length - 1].url; // no-srcset fallback
    // Mirrors the tile's own flex-basis math so `sizes` matches its real box.
    const desktopSizePx = Math.min(Math.round((r.width * 350) / r.height), GRID_WIDTH);

    return {
      width: r.width,
      height: r.height,
      gridUrl,
      gridSrcset,
      gridSizes: `(max-width: 639px) calc(50vw - 6px), ${desktopSizePx}px`,
      enlargedUrl,
      title,
      description,
      sizes: displaySizes,
      priceSummary: priceSummary(displaySizes),
      category: dbInfo?.category ?? "",
    };
  })
);
---

<div id="print-filters" class="flex flex-wrap gap-2 px-2 py-4">
  <button class="filter-btn active" data-filter="" aria-pressed="true">All</button>
  <button class="filter-btn" data-filter="concert" aria-pressed="false">Concert</button>
  <button class="filter-btn" data-filter="knicks" aria-pressed="false">Knicks</button>
  <button class="filter-btn" data-filter="landscape" aria-pressed="false">Landscape</button>
</div>

<div class="flex flex-wrap m-0.5 select-none" id="print-grid">
  {
    items.map((item, index) => (
      <div
        class="print-tile group relative m-0.5 cursor-pointer overflow-hidden max-w-[calc(50%-4px)] sm:max-w-none"
        data-index={index}
        data-category={item.category}
        style={`flex-grow: ${(item.width * 350) / item.height}; flex-basis: ${(item.width * 350) / item.height}px;`}
        onclick="openPrint(this)"
        tabindex="0"
        role="button"
        aria-label={`View ${item.title}`}
      >
        {/* aspect-ratio spacer */}
        <div class="block" style={`padding-bottom: ${(item.height / item.width) * 100}%`} />

        <img
          src={item.gridUrl}
          srcset={item.gridSrcset}
          sizes={item.gridSizes}
          alt={item.title}
          loading="lazy"
          draggable="false"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />

        {/* hover overlay: title + description + price */}
        <div class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/20 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
          <h3 class="text-base font-semibold leading-tight text-white drop-shadow">
            {item.title}
          </h3>
          {item.description && (
            <p class="clamp-2 mt-1 text-sm text-neutral-200 drop-shadow">
              {item.description}
            </p>
          )}
          {item.priceSummary && (
            <p class="mt-2 text-sm font-semibold tracking-wide text-white drop-shadow">
              {item.priceSummary}
            </p>
          )}
        </div>
      </div>
    ))
  }
</div>

{/* ───────────────── Enlarged view (custom lightbox) ───────────────── */}
<div
  id="print-lightbox"
  class="fixed inset-0 z-50 hidden items-stretch justify-center bg-black/95 backdrop-blur-sm md:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="print-lightbox-title"
  aria-hidden="true"
>
  <div class="relative flex h-full w-full flex-col md:flex-row">
    {/* image */}
    <div class="relative flex flex-1 items-center justify-center overflow-hidden p-2 md:p-8">
      <img
        id="print-lightbox-img"
        src=""
        alt=""
        draggable="false"
        class="max-h-full max-w-full select-none object-contain"
      />
    </div>

    {/* metadata panel */}
    <aside
      class="w-full shrink-0 overflow-y-auto border-t border-neutral-800 bg-neutral-950/90 p-6 text-slate-100 md:w-96 md:border-l md:border-t-0"
    >
      <h2 id="print-lightbox-title" class="text-2xl font-semibold leading-tight"></h2>
      <p id="print-lightbox-desc" class="mt-3 text-sm leading-relaxed text-neutral-300"></p>

      <div id="print-lightbox-pricing" class="mt-6 border-t border-neutral-800 pt-4">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400">
          Prints
        </h3>
        <ul id="print-lightbox-sizes" class="mt-3 space-y-2 text-sm"></ul>
        <p id="print-lightbox-price" class="mt-2 hidden text-lg font-semibold"></p>
      </div>

      <a
        id="print-lightbox-inquire"
        href="#"
        class="mt-6 inline-block rounded-full bg-slate-100 px-5 py-2 text-sm font-semibold text-neutral-900 transition-colors hover:bg-white"
      >
        Inquire to purchase
      </a>
    </aside>

    {/* controls */}
    <button
      type="button"
      id="print-lightbox-close"
      onclick="closePrint()"
      class="absolute left-3 top-3 z-10 rounded-full bg-neutral-800/70 p-3 hover:bg-neutral-700"
    >
      <Icon name="x" />
      <span class="sr-only">close</span>
    </button>
    <button
      type="button"
      onclick="stepPrint(-1)"
      class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-neutral-800/70 p-3 hover:bg-neutral-700"
    >
      <Icon name="left" />
      <span class="sr-only">previous</span>
    </button>
    <button
      type="button"
      onclick="stepPrint(1)"
      class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-neutral-800/70 p-3 hover:bg-neutral-700 md:right-[25rem]"
    >
      <Icon name="right" />
      <span class="sr-only">next</span>
    </button>
  </div>
</div>

<script define:vars={{
  // Grid-only fields (gridUrl/gridSrcset/gridSizes/width/height/category) are
  // already on the DOM — trimmed here to shrink the duplicated HTML payload.
  items: items.map(({ enlargedUrl, title, description, sizes, priceSummary }) => (
    { enlargedUrl, title, description, sizes, priceSummary }
  )),
  inquireEmail: "josh@rehders.photos",
}} is:inline>
  const PRINTS = items;
  let currentFilter = "";
  let currentVisiblePos = 0;
  let currentIndex = null; // absolute PRINTS index of the open item, for filter re-anchoring
  let lightboxOpen = false;
  let lastFocusedTile = null;
  let visibleIndicesCache = null; // declared early: applyFilter below writes it

  function rebuildVisibleIndices() {
    if (visibleIndicesCache) return visibleIndicesCache;
    visibleIndicesCache = [...document.querySelectorAll(".print-tile")]
      .filter((t) => t.style.display !== "none")
      .map((t) => Number(t.dataset.index));
    return visibleIndicesCache;
  }

  // ── Filtering ──────────────────────────────────────────────────────────────
  // Applied before shuffle/eager-promotion below so a filtered deep-link never
  // lets hidden tiles consume the eager/high-priority budget.

  // `updateHistory` is false for popstate/initial-URL application — those are
  // already reflecting history, so pushing again would create a bogus entry.
  function applyFilter(filter, { updateHistory = true } = {}) {
    if (filter === currentFilter) return; // short-circuit no-op re-clicks
    currentFilter = filter;
    visibleIndicesCache = null; // invalidate on real filter change only
    const tiles = document.querySelectorAll(".print-tile");
    tiles.forEach((tile) => {
      const cat = tile.dataset.category ?? "";
      tile.style.display = (!filter || cat === filter) ? "" : "none";
    });

    document.querySelectorAll(".filter-btn").forEach((btn) => {
      const isActive = btn.dataset.filter === filter;
      btn.classList.toggle("active", isActive);
      btn.setAttribute("aria-pressed", String(isActive));
    });

    if (updateHistory) {
      const url = new URL(window.location.href);
      if (filter) url.searchParams.set("filter", filter);
      else url.searchParams.delete("filter");
      history.pushState({ filter }, "", url.toString());
    }

    // Re-anchor the open lightbox to its item's new position, or close it
    // safely if the item is no longer visible under this filter.
    if (lightboxOpen && currentIndex !== null) {
      const vis = rebuildVisibleIndices();
      const pos = vis.indexOf(currentIndex);
      if (pos >= 0) currentVisiblePos = pos;
      else closePrint();
    }
  }

  // Wire filter buttons
  document.querySelectorAll(".filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.filter ?? ""));
  });

  // Apply filter from URL on load — before shuffle, so eager/high promotion
  // below only ever considers tiles that are actually visible.
  const initialFilter = new URL(window.location.href).searchParams.get("filter") ?? "";
  if (initialFilter) applyFilter(initialFilter, { updateHistory: false });

  // popstate's history entry may predate any pushState (e.g. a page loaded
  // directly at ?filter=X), so read the now-navigated URL, not event.state.
  window.addEventListener("popstate", () => {
    const filter = new URL(window.location.href).searchParams.get("filter") ?? "";
    applyFilter(filter, { updateHistory: false });
  });

  // ── Shuffle DOM tiles, then promote the real first-visual tiles ────────────
  // Runs after the initial filter above so hidden (filtered-out) tiles are
  // never candidates. Default loading="lazy" keeps the preload scanner from
  // front-running this reorder with stale pre-shuffle guesses.

  function shuffleGrid() {
    const grid = document.getElementById("print-grid");
    const tiles = [...grid.querySelectorAll(".print-tile")];
    for (let i = tiles.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
    }
    // Single DocumentFragment append = one reflow instead of one per tile.
    const fragment = document.createDocumentFragment();
    tiles.forEach((t) => fragment.appendChild(t));
    grid.appendChild(fragment);
    return tiles;
  }

  const orderedTiles = shuffleGrid();
  // Only tiles the initial filter left visible are eligible for eager/high.
  const visibleOrderedTiles = orderedTiles.filter((t) => t.style.display !== "none");

  // Random masonry means DOM tile 0 isn't reliably the largest visible one —
  // measure real intersection area (one getBoundingClientRect batch, no
  // interceding writes/rAF) so "high" priority lands on the actual LCP candidate.
  // Eager count is viewport-tuned: mobile shows ~4 tiles per row (fewer,
  // narrower images to avoid contention); desktop needs ~2 rows (9) since
  // measured LCP candidates land past index 6 there.
  const vw = window.innerWidth;
  const vh = window.innerHeight;
  const eagerCount = vw < 640 ? 4 : 9;
  const eagerCandidates = visibleOrderedTiles
    .slice(0, eagerCount)
    .map((tile) => ({ tile, img: tile.querySelector("img") }))
    .filter((c) => c.img);

  let winner = null;
  let winnerArea = 0;
  for (const c of eagerCandidates) {
    const r = c.tile.getBoundingClientRect(); // clips against actual viewport bounds
    const w = Math.min(r.right, vw) - Math.max(r.left, 0);
    const h = Math.min(r.bottom, vh) - Math.max(r.top, 0);
    const area = Math.max(0, w) * Math.max(0, h);
    if (area > winnerArea) {
      winnerArea = area;
      winner = c.img;
    }
  }
  if (winner) winner.fetchPriority = "high"; // set before flipping loading below
  for (const c of eagerCandidates) c.img.loading = "eager";

  // ── Lightbox ───────────────────────────────────────────────────────────────

  // Bounded ±1 neighbor prefetch/decode cache — pruned to the current
  // neighbor pair on every step so it can't grow across navigation.
  const prefetchCache = new Map(); // enlargedUrl -> Image

  // Only delete if this exact (possibly stale/replaced) Image still occupies
  // the slot, so a fresh retry inserted after a failure is never evicted.
  function evictIfStale(url, img) {
    if (prefetchCache.get(url) === img) prefetchCache.delete(url);
  }

  function cachedImage(url, priority) {
    let img = prefetchCache.get(url);
    if (!img) {
      img = new Image();
      img.decoding = "async";
      if (priority) img.fetchPriority = priority; // must be set before src
      img.addEventListener("error", () => evictIfStale(url, img)); // let later opens retry
      img.src = url;
      prefetchCache.set(url, img);
    } else if (priority) {
      img.fetchPriority = priority; // promoted from neighbor to active
    }
    return img;
  }

  function prefetchNeighbors(vis, pos) {
    if (!vis.length) return; // nothing visible to prefetch
    // Includes delta 0 (current) so the imminent cachedImage(url, "high") call
    // in showPrint reuses this entry instead of evicting it moments earlier.
    const wanted = new Set();
    for (const delta of [-1, 0, 1]) {
      const item = PRINTS[vis[(pos + delta + vis.length) % vis.length]];
      if (item) wanted.add(item.enlargedUrl);
    }
    for (const url of prefetchCache.keys()) {
      if (!wanted.has(url)) prefetchCache.delete(url); // bounded to at most these 3
    }
    wanted.forEach((url) => cachedImage(url, "low"));
  }

  function renderPricing(item) {
    const sizesEl = document.getElementById("print-lightbox-sizes");
    const priceEl = document.getElementById("print-lightbox-price");
    sizesEl.innerHTML = "";
    priceEl.classList.add("hidden");

    if (item.sizes && item.sizes.length) {
      for (const s of item.sizes) {
        const li = document.createElement("li");
        const isOther = s.price === "Varies";
        li.className = isOther
          ? "flex items-baseline justify-between gap-4 pt-2 mt-1 border-t border-neutral-800/60 text-neutral-500 italic text-xs"
          : "flex items-baseline justify-between gap-4 border-b border-neutral-800/60 pb-2";
        const label = document.createElement("span");
        label.className = isOther ? "" : "text-neutral-300";
        label.textContent = s.label;
        const price = document.createElement("span");
        price.className = isOther ? "" : "font-semibold";
        price.textContent = s.price;
        li.append(label, price);
        sizesEl.appendChild(li);
      }
    } else if (item.price) {
      priceEl.textContent = item.price;
      priceEl.classList.remove("hidden");
    }
  }

  let showToken = 0; // bumped per call so a slower, superseded swap can bail

  function renderMetadata(item) {
    document.getElementById("print-lightbox-title").textContent = item.title;
    const descEl = document.getElementById("print-lightbox-desc");
    descEl.textContent = item.description || "";
    descEl.style.display = item.description ? "" : "none";
    renderPricing(item);
    const inquire = document.getElementById("print-lightbox-inquire");
    inquire.href = `mailto:${inquireEmail}?subject=${encodeURIComponent(`Print inquiry: ${item.title}`)}`;
  }

  async function showPrint(vis, visiblePos) {
    const index = vis[visiblePos];
    if (index === undefined) return; // empty visible set: safe no-op
    currentVisiblePos = visiblePos;
    currentIndex = index; // track absolute index for filter re-anchoring
    const item = PRINTS[index];
    const token = ++showToken;

    const img = document.getElementById("print-lightbox-img");
    // Own grid thumbnail is always the correct match for this item's metadata;
    // `src` covers a lazy tile that hasn't set `currentSrc` from a real fetch yet.
    const gridImg = document.querySelector(`.print-tile[data-index="${index}"] img`);
    const fallbackSrc = gridImg && (gridImg.currentSrc || gridImg.src);
    if (fallbackSrc) {
      img.src = fallbackSrc;
      img.alt = gridImg.alt || item.title;
    }

    // Metadata/inquiry/prefetch run synchronously so they never lag behind
    // a slow enlarged decode and pair with the wrong photo.
    renderMetadata(item);
    prefetchNeighbors(vis, visiblePos);

    // `.complete` is also true for a failed image, so gate on naturalWidth too.
    const preload = cachedImage(item.enlargedUrl, "high");
    const isReady = () => preload.complete && preload.naturalWidth > 0;
    if (!isReady()) {
      // Broken/slow: keep the thumbnail fallback, and evict so a later open retries.
      try { await preload.decode(); } catch { evictIfStale(item.enlargedUrl, preload); }
    }
    if (token !== showToken) return; // superseded by a newer step: leave state alone

    if (isReady()) {
      img.fetchPriority = "high";
      img.src = item.enlargedUrl; // decoded — swaps without a blank frame
      img.alt = item.title;
    }
  }

  function openPrint(tile) {
    const index = Number(tile.dataset.index);
    const vis = rebuildVisibleIndices();
    if (!vis.length) return; // nothing visible under the current filter
    const pos = vis.indexOf(index);
    currentVisiblePos = pos >= 0 ? pos : 0;
    showPrint(vis, currentVisiblePos);
    lastFocusedTile = tile;
    lightboxOpen = true;
    const lb = document.getElementById("print-lightbox");
    lb.classList.remove("hidden");
    lb.classList.add("flex");
    lb.setAttribute("aria-hidden", "false");
    document.body.classList.add("overflow-hidden");
    document.getElementById("print-lightbox-close")?.focus();
  }

  function closePrint() {
    showToken++; // discard any in-flight decode/swap
    const lb = document.getElementById("print-lightbox");
    lb.classList.add("hidden");
    lb.classList.remove("flex");
    lb.setAttribute("aria-hidden", "true");
    document.body.classList.remove("overflow-hidden");
    lightboxOpen = false;
    currentIndex = null;
    // Fall back to the active filter button if the triggering tile was hidden
    // by the filter change that caused this close, so focus isn't lost.
    const focusTarget =
      lastFocusedTile && lastFocusedTile.style.display !== "none"
        ? lastFocusedTile
        : document.querySelector(".filter-btn.active");
    focusTarget?.focus();
    lastFocusedTile = null;
  }

  function stepPrint(delta) {
    const vis = rebuildVisibleIndices();
    if (!vis.length) return; // avoid a % 0 / NaN position
    const next = (currentVisiblePos + delta + vis.length) % vis.length;
    currentVisiblePos = next;
    showPrint(vis, next);
  }

  // expose for inline handlers
  window.openPrint = openPrint;
  window.closePrint = closePrint;
  window.stepPrint = stepPrint;

  // Delegated so shuffled/promoted tiles are covered without per-tile listeners.
  document.getElementById("print-grid").addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const tile = e.target.closest(".print-tile");
    if (!tile) return;
    e.preventDefault();
    openPrint(tile);
  });

  // Anti-theft: block the "save image" context menu on protected imagery.
  document.getElementById("print-grid").addEventListener("contextmenu", (e) => {
    if (e.target.tagName === "IMG") e.preventDefault();
  });
  document.getElementById("print-lightbox-img").addEventListener("contextmenu", (e) => e.preventDefault());

  document.addEventListener("keydown", (e) => {
    const lb = document.getElementById("print-lightbox");
    if (!lb || lb.classList.contains("hidden")) return;
    if (e.key === "Escape") closePrint();
    else if (e.key === "ArrowLeft") stepPrint(-1);
    else if (e.key === "ArrowRight") stepPrint(1);
    else if (e.key === "Tab") trapFocus(e, lb);
  });

  // Keep Tab from escaping the dialog to the background page.
  function trapFocus(e, lb) {
    const focusables = [...lb.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])')].filter(
      (el) => el.offsetParent !== null
    );
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    } else if (!focusables.includes(active)) {
      e.preventDefault(); // focus drifted outside the dialog — pull it back in
      first.focus();
    }
  }

  document.getElementById("print-lightbox")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closePrint();
  });

  let touchStartX = 0;
  let touchStartY = 0;
  const lbEl = document.getElementById("print-lightbox");
  lbEl?.addEventListener("touchstart", (e) => {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
  }, { passive: true });
  lbEl?.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].screenX - touchStartX;
    const dy = e.changedTouches[0].screenY - touchStartY;
    // Require horizontal dominance so vertical/diagonal metadata scrolling
    // isn't misread as a step gesture.
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) stepPrint(dx < 0 ? 1 : -1);
  });
</script>

<style>
  .clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Safe: the aspect-ratio spacer already reserves tile height. Standalone
     rule — delete this block alone if CLS profiling regresses. */
  .print-tile {
    content-visibility: auto;
    contain-intrinsic-size: auto 250px;
  }

  .filter-btn {
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid rgb(64 64 64);
    background: transparent;
    color: rgb(163 163 163);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .filter-btn:hover {
    background: rgb(38 38 38);
    color: #fff;
    border-color: rgb(115 115 115);
  }
  .filter-btn.active {
    background: rgb(248 248 248);
    color: rgb(10 10 10);
    border-color: transparent;
  }
</style>
