// Calculate statistics
const allShows = showsData.flatMap(yearData => yearData.shows);
const totalShows = allShows.length;
const photographedShows = allShows.filter(show => show.photographed).length;
const attendedShows = allShows.filter(show => !show.photographed).length;
---

<Layout
  title="Josh Rehders — Past Shows"
  description="Josh Rehders is a multimedia creative specialist based in New York City, with a focus on capturing electronic music events."
>

  <main>  
    <Header />
    <div class="about-container">
      <div>
        <div class="by-the-numbers">
          <p class="small-info-text">This page is mainly for my own reference and documentation, but maybe you'll find it interesting as well!</p>
          <p class="numbers-text">
            <strong>{photographedShows}</strong> shows photographed, <strong>{attendedShows}</strong> shows attended, <strong>{totalShows}</strong> total shows
          </p>
        </div>

        <div class="filter-container">
          <label for="show-filter">Filter Shows:</label>
          <select id="show-filter">
            <option value="photographed" selected>Photographed Only</option>
            <option value="attended">Attended Only</option>
            <option value="all">All Shows</option>
          </select>
        </div>
        
        <div class="shows-container">
          {showsData.map(yearData => (
            <div class="year-section">
              <h2 class="year-header">{yearData.year}</h2>
              {yearData.shows.length === 0 ? (
                <p class="no-shows">No shows this year</p>
              ) : (
                <div class="shows-list">
                  {yearData.shows.map(show => (
                    <div class={`show-item ${show.photographed ? 'photographed' : 'not-photographed'}`}>
                      <div class="show-main">
                        <div class="show-name">{show.name}</div>
                          <div class="show-location">
                            <div class="show-city">{show.city}</div>
                            <div class="show-venue">{show.venue}</div>
                          </div>
                        {/* {show.photographed && <span class="photo-indicator">📸</span>} */}
                      </div>
                      {show.photographed && show.photographedArtists && show.photographedArtists.length > 0 && (
                        <div class="show-artists">
                          <div class="artist-section">
                            <span class="artist-section-title">Photographed:</span>
                            {show.photographedArtists.map((artist: string) => (
                              <span class="artist-tag photographed-artist">{artist}</span>
                            ))}
                          </div>
                        </div>
                      )}
                      {show.allArtists && show.allArtists.length > (show.photographedArtists?.length || 0) && (
                        <div class="show-artists also-performing-section">
                          <div class="artist-section">
                            <span class="artist-section-title">
                              {show.photographedArtists && show.photographedArtists.length > 0 ? "Other performers seen:" : "Performers:"}
                            </span>
                            {show.allArtists.filter(artist => !show.photographedArtists?.includes(artist)).map((artist: string) => (
                              <span class="artist-tag other-artist">{artist}</span>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
                  {yearData.shows.length > 0 && !yearData.shows.some(show => show.photographed) && (
                    <p class="no-shows no-photographed-shows">No shows photographed this year</p>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

  <style>
    .about-container div {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

      /* Media query for phone-sized screens */
    @media (max-width: 600px) {
      .about-container div {
        margin-left: auto !important;
        margin-right: auto !important;
      }
    }

    .by-the-numbers {
      margin-bottom: 1rem;
      text-align: left;
    }

    .small-info-text {
      font-size: 0.7rem;
      color: #aaa;
      margin: 0 0 0.25rem 0;
    }

    .numbers-text {
      font-size: 1.1rem;
      color: #ccc;
      margin: 0;
    }

    .numbers-text strong {
      color: #9395CC;
      font-weight: bold;
    }

    @media (max-width: 768px) {
      .numbers-text {
        font-size: 1rem;
      }
    }

    .filter-container {
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: auto;
    }

    #show-filter {
      padding: 0.2rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      background: gray;
    }

    .year-section {
      margin-bottom: 3rem;
    }

    .year-header {
      font-size: 1.8rem;
      font-weight: bold;
      margin-bottom: 1rem;
      border-bottom: 2px solid #333;
      padding-bottom: 0.5rem;
    }

    .no-shows {
      font-style: italic;
      color: #666;
    }

    .no-photographed-shows {
      display: block;
    }

    .no-photographed-shows.filter-hidden {
      display: none;
    }

    .shows-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .show-item {
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1rem;
      transition: all 0.3s ease;
      width: 600px;
    }

    .show-item.photographed {
      background: #f8fff8;
      border-color: #9395CC;
    }

    .show-item.not-photographed {
      background: #f8f8f8;
      opacity: 0.8;
    }

    .show-item.hidden {
      display: none;
    }

    .show-main {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }

    .show-name {
      font-weight: bold;
      font-size: 1.1rem;
      color: #000
    }

    .show-location {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .show-city {
      color: #444;
      font-weight: 500;
    }

    .show-venue {
      color: #666;
      font-style: italic;
    }

    .show-venue:before {
      content: "•";
      margin-right: 0.5rem;
      color: #ccc;
    }

    .photo-indicator {
      margin-left: auto;
      font-size: 1.2rem;
    }

    .show-artists {
      margin-top: 0.5rem;
    }

    .artist-section {
      margin-bottom: 0.5rem;
    }

    .artist-section-title {
      font-size: 0.85rem;
      font-weight: bold;
      color: #555;
      margin-right: 0.5rem;
      display: block;
      margin-bottom: 0.25rem;
    }

    .artist-tag {
      background: #e0e0e0;
      padding: 0.2rem 0.5rem;
      border-radius: 12px;
      font-size: 0.8rem;
      color: #555;
      margin-right: 0.5rem;
      margin-bottom: 0.25rem;
      display: inline-block;
    }

    .photographed-artist {
      background: #c8e6c9;
      color: #2e7d32;
      font-weight: 500;
    }

    .other-artist {
      background: #c0c0c0;
      color: #444;
    }

    .also-performing-section {
      display: block;
    }

    .also-performing-section.filter-hidden {
      display: none;
    }

    @media (max-width: 768px) {
      .show-main {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .photo-indicator {
        margin-left: 0;
      }
    }
  </style>

  <script>
    const filterSelect = document.getElementById('show-filter') as HTMLSelectElement;
    const showItems = document.querySelectorAll('.show-item');
    const alsoPerformingSections = document.querySelectorAll('.also-performing-section');
    const noPhotographedMessages = document.querySelectorAll('.no-photographed-shows');

    filterSelect?.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const filterValue = target.value;
      
      showItems.forEach(item => {
        if (filterValue === 'all') {
          item.classList.remove('hidden');
        } else if (filterValue === 'photographed') {
          if (item.classList.contains('photographed')) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        } else if (filterValue === 'attended') {
          if (item.classList.contains('not-photographed')) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        }
      });

      // Hide/show "also performing" sections based on filter
      alsoPerformingSections.forEach(section => {
        if (filterValue === 'photographed') {
          section.classList.add('filter-hidden');
        } else {
          section.classList.remove('filter-hidden');
        }
      });

      // Hide/show "no photographed shows" messages based on filter
      noPhotographedMessages.forEach(message => {
        if (filterValue === 'all' || filterValue === 'attended') {
          message.classList.add('filter-hidden');
        } else {
          message.classList.remove('filter-hidden');
        }
      });
    });

    // Initialize with photographed filter
    document.addEventListener('DOMContentLoaded', () => {
      showItems.forEach(item => {
        if (!item.classList.contains('photographed')) {
          item.classList.add('hidden');
        }
      });
      
      // Initially hide "also performing" sections
      alsoPerformingSections.forEach(section => {
        section.classList.add('filter-hidden');
      });

      // Show "no photographed shows" messages initially (since photographed filter is default)
      noPhotographedMessages.forEach(message => {
        message.classList.remove('filter-hidden');
      });
    });
  </script>

</Layout>
