---
import { icons } from "../icons/icons.ts";

interface Props {
    name: keyof typeof icons;
}

const { name } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" aria-hidden="true" data-slot="icon" class="m-2 h-6 fill-slate-100"><path fill-rule="evenodd" d={icons[name]} clip-rule="evenodd"></path></svg>