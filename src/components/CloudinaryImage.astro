---
// filepath: /Users/joshrehders/photo/src/components/CloudinaryImage.astro
// Create a component specifically for Cloudinary images
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const { 
  src, 
  alt, 
  width, 
  height, 
  sizes = "(min-width: 1150px) 50vw, (min-width: 900px) 75vw, 100vw", 
  loading = "lazy",
  class: className = ""
} = Astro.props;

// Add image optimization params to the Cloudinary URL
const optimizedSrc = src.includes('cloudinary.com') 
  ? src.replace('/upload/', '/upload/f_auto,q_auto/')
  : src;

// Create srcset with different widths
const widths = [320, 480, 640, 768, 1024, 1280, 1536, 1920, 2048, 2560, 3840];
const srcset = widths
  .map(w => {
    const optimizedUrl = src.replace('/upload/', `/upload/w_${w},f_auto,q_auto/`);
    return `${optimizedUrl} ${w}w`;
  })
  .join(', ');
---

<img 
  src={optimizedSrc} 
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  srcset={srcset}
  sizes={sizes}
  class={className}
/>