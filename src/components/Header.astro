---
import SocialIcons from './SocialIcons.astro';

interface Props {
  extended?: boolean;
}

const { extended = false } = Astro.props;

const baseMenuItems = [
  { name: 'CONCERT PHOTO', href: '/' },
  { name: 'CONCERT VIDEO', href: '/video/' },
  { name: 'BTS/PORTRAIT', href: '/bts/' },
  { name: 'SPORTS', href: '/sports/' },
];

const extendedMenuItems = [
  { name: 'LIFESTYLE', href: '/lifestyle/' },
  { name: 'EVENTS', href: '/events/' },
];

const menuItems = extended 
  ? [...baseMenuItems, ...extendedMenuItems, { name: 'ABOUT', href: '/about/' }]
  : [...baseMenuItems, { name: 'ABOUT', href: '/about/' }];
---

<header class="header">
  <div class="header-left">
    <a href="/">
      <h1>JOSH REHDERS</h1>
      <h1 style={{ marginTop: '-6px' }}>NEW YORK CITY & BEYOND</h1>
    </a>
    <p><a href="mailto:josh@rehders.photos">JOSH@REHDERS.PHOTOS</a></p>
  </div>
  <nav class="header-nav">
    {menuItems.map(item => (
      <a href={item.href} class={`header-link${item.href === Astro.url.pathname ? '-active' : ''}`}>{item.name}</a>
    ))}
    <SocialIcons />
  </nav>
</header>