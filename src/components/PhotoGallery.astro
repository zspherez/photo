---
import Icon from '../components/Icon.astro'
import {
  buildImageUrl,
  getMediaFolder,
  type MediaAsset,
} from "../lib/media";

export interface Props {
  folder?: string;
  folders?: string[];
  filter?: string;
}

// Only fetch images (no videos). Supports a single folder or multiple folders interleaved.
const folders = Astro.props.folders ?? (Astro.props.folder ? [Astro.props.folder] : []);
const lists = folders.map((folder) => getMediaFolder(folder).filter((asset) => asset.type === "image"));

// Interleave: take one from each folder in turn until all are exhausted.
const filteredResources: MediaAsset[] = [];
const maxLen = Math.max(0, ...lists.map((l) => l.length));
for (let i = 0; i < maxLen; i++) {
  for (const list of lists) {
    if (i < list.length) filteredResources.push(list[i]);
  }
}

// Fixed ladder (capped at 1920) — the native-width-derived ladder was producing 12-17 entries
// per image, some over 6000w that no viewport here will ever request.
const BREAKPOINTS = [320, 480, 640, 960, 1280, 1920];

const resourceRatio = (resource: MediaAsset) =>
  resource.aspectRatio || resource.width / resource.height;

// Bucketed by aspect ratio because the justified/flex-grow grid gives landscape tiles more row
// width than portrait/square ones — a flat 33vw either overfetches or underfetches depending on
// shape. These are generous upper bounds, not exact measurements (layout is unknown at build time).
function getSizes(resource: MediaAsset): string {
  const ratio = resourceRatio(resource);
  let tabletVw = 45;
  let desktopVw = 30;
  let capPx = 460;

  if (ratio >= 1.35) {
    // landscape: larger flex-basis, fewer tiles share a row
    tabletVw = 60;
    desktopVw = 42;
    capPx = 620;
  } else if (ratio <= 0.8) {
    // portrait: smaller flex-basis, more tiles share a row
    tabletVw = 34;
    desktopVw = 22;
    capPx = 340;
  }

  return `(max-width: 639px) calc(50vw - 6px), (max-width: 1023px) ${tabletVw}vw, (max-width: 1919px) ${desktopVw}vw, ${capPx}px`;
}

// Covers the profiled first two rows (desktop LCP was index 6, mobile was index 1), not just
// index 0. Of that set, at most two tiles (strongest landscape + strongest portrait) get
// fetchpriority="high" so both layouts get a priority signal without flooding the network.
const EAGER_COUNT = Math.min(8, filteredResources.length);
const eagerCandidates = filteredResources.slice(0, EAGER_COUNT);
let landscapeIndex = -1;
let portraitIndex = -1;
eagerCandidates.forEach((resource, i) => {
  if (landscapeIndex === -1 || resourceRatio(resource) > resourceRatio(eagerCandidates[landscapeIndex])) {
    landscapeIndex = i;
  }
  if (portraitIndex === -1 || resourceRatio(resource) < resourceRatio(eagerCandidates[portraitIndex])) {
    portraitIndex = i;
  }
});
---

<div class="flex flex-wrap m-0.5" data-gallery-count={filteredResources.length}>

  {filteredResources.map((resource, index) => {
    const isEager = index < EAGER_COUNT;
    const isPriority = index === landscapeIndex || index === portraitIndex;
    const srcset = BREAKPOINTS.map(
      (width) => `${buildImageUrl(resource.key, `w-${width}`)} ${width}w`,
    ).join(", ");

    return (
      <div
        data-position={`${index == 0 ? "first" : index + 1 == filteredResources.length ? "last" : "middle"}`}
        data-public-id={resource.publicId}
        data-fullscreen-url={buildImageUrl(resource.key, "fullscreen")}
        data-width={resource.width}
        data-height={resource.height}
        data-alt={resource.alt}
        tabindex="0"
        role="button"
        aria-label={`View photo ${index + 1} of ${filteredResources.length}`}
        onclick="setFullscreen(this)"
        class="relative m-0.5 cursor-zoom-in fullscreen:cursor-auto max-w-[calc(50%-4px)] sm:max-w-none"
        style={`flex-grow: ${resource.width * 350 / resource.height}; flex-basis: ${resource.width * 350 / resource.height}px;`}
      >

        <!-- placeholder for proper grid sizing -->
        <div class="block" style={`padding-bottom: ${resource.height / resource.width * 100}%`}></div>

        <img
          src={buildImageUrl(resource.key, "w-960")}
          srcset={srcset}
          width={resource.width}
          height={resource.height}
          alt={resource.alt}
          sizes={getSizes(resource)}
          class={`resource absolute align-bottom top-0 w-full h-full object-cover fullscreen:pointer-events-none ${isEager ? "" : "opacity-0 transition-opacity ease-in duration-1000"}`}
          loading={isEager ? "eager" : "lazy"}
          fetchpriority={isPriority ? "high" : undefined}
        />
      </div>
    );
  })}

</div>

<div id="fullscreen-backdrop" class="fixed scale-200 inset-0 z-[1] w-screen h-screen bg-black pointer-events-none opacity-0 transition-opacity duration-200"></div>

<div id="fullscreen-controls" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true" class="fixed top-0 z-[3] w-screen h-screen pointer-events-none opacity-0 transition-opacity duration-200">
  <button type="button" onclick="prevResource()" tabindex="-1" class="fixed left-0 mt-[25vh] flex h-[50vh] w-[15vw] items-center opacity-0 hover:opacity-100 focus-visible:opacity-100 md:w-[25vw]">
    <div class="absolute left-0 ml-4 rounded-full bg-neutral-700 p-2 md:ml-8 md:p-4">
       <Icon name="left" />
      <span class="sr-only">previous image</span>
    </div>
  </button>

  <button type="button" onclick="nextResource()" tabindex="-1" class="fixed right-0 mt-[25vh] flex h-[50vh] w-[15vw] items-center opacity-0 hover:opacity-100 focus-visible:opacity-100 md:w-[25vw]">
    <div class="absolute right-0 mr-4 rounded-full bg-neutral-700 p-2 md:mr-8 md:p-4">
      <Icon name="right" />
      <span class="sr-only">next image</span>
    </div>
  </button>

  <button id="fullscreen-close-btn" type="button" onclick="escapeFullscreen()" tabindex="-1" class="fixed ml-2 mt-2 rounded-full bg-neutral-700/50 p-3 hover:bg-neutral-700">
    <Icon name="x" />
    <span class="sr-only">exit image</span>
  </button>
</div>

<script is:inline>
  let isAnimating = false;
  // Set when Escape/close-button fires mid-animation; resolved once the animation settles.
  let closeRequested = false;
  // Latest-direction-wins queue for Arrow presses that land mid-transition — coalesces rapid
  // key-repeat into a single pending step instead of dropping input or stacking an unbounded queue.
  let queuedDirection = null;
  // A high-quality image that resolved while a transition was in flight; applied once it settles
  // so a cache-fast HQ load can never pop/race mid-animation.
  const pendingHq = new Map();
  // Tracks the tile that opened the lightbox, for focus restoration on close.
  let openerElement = null;
  const galleryWrapper = document.querySelector("[data-gallery-count]");
  // Lets prev/next safely no-op for 0/1-image galleries.
  const galleryCount = Number(galleryWrapper?.dataset.galleryCount || 0);
  // Monotonic counter so a stale high-quality image load can't overwrite a tile it no longer belongs to.
  let hqRequestId = 0;

  function setFullscreen(element) {
    // Blocks a reopen/re-entry while a previous open/close animation is still settling — without
    // this, a rapid reopen during the 200ms close window could be torn down by the old timer.
    if (isAnimating || element.id == "fullscreen") {
      return;
    }

    openerElement = element;

    // Start loading high-quality image immediately
    const resource = element.querySelector(".resource");
    loadHighQualityImage(element, resource);

    disableScrolling();
    enableFullscreenControls();
    element.id = "fullscreen";
    document.getElementById("fullscreen-close-btn")?.focus();

    zoomIn(resource);
  }

  // Common settle point for every animation (open zoom, close zoom, slide): flips isAnimating
  // back off, applies any HQ load that was deferred while busy, then runs whatever was queued.
  function settleAnimation() {
    isAnimating = false;

    resolveQueuedClose();

    if (queuedDirection && document.getElementById("fullscreen")) {
      // The current tile is transient, so discard its deferred HQ swap and give the browser one
      // paint between teardown and the next transition instead of stacking both in one frame.
      pendingHq.clear();
      scheduleQueuedSlide();
      return;
    }
    if (queuedDirection) queuedDirection = null;

    if (pendingHq.size) {
      const fullscreenImage = document.getElementById("fullscreen")?.querySelector(".resource");
      const pending = fullscreenImage ? pendingHq.get(fullscreenImage) : null;
      pendingHq.clear();
      if (!pending) return;
      const { imgElement, requestId, apply } = pending;
      if (
        imgElement.dataset.hqRequestId === String(requestId)
        && imgElement.closest("[data-position]")?.id === "fullscreen"
      ) {
        apply();
      }
    }
  }

  function scheduleQueuedSlide() {
    const direction = queuedDirection;
    queuedDirection = null;
    isAnimating = true;

    requestAnimationFrame(() => {
      isAnimating = false;
      if (closeRequested) {
        queuedDirection = null;
        resolveQueuedClose();
        return;
      }
      if (!document.getElementById("fullscreen")) {
        queuedDirection = null;
        return;
      }
      if (direction === "prev") prevResource();
      else nextResource();
    });
  }

  function loadHighQualityImage(element, imgElement) {
    const highQualityUrl = element.dataset.fullscreenUrl;
    
    if (!highQualityUrl || !imgElement) return;

    // Captured once so the original responsive image can always be restored later.
    if (!imgElement.dataset.originalSrc) {
      imgElement.dataset.originalSrc = imgElement.getAttribute('src') || '';
      imgElement.dataset.originalSrcset = imgElement.getAttribute('srcset') || '';
    }

    // Tags this load so a later, stale resolution can be told apart from the current one.
    const requestId = ++hqRequestId;
    imgElement.dataset.hqRequestId = String(requestId);

    // Preload the high-quality image
    const highQualityImg = new Image();
    highQualityImg.onload = () => {
      // Stale guard: a later request or a fully-closed/reset tile invalidates this load
      // (resetElement() deletes hqRequestId on every close/slide-out).
      if (imgElement.tagName !== 'IMG' || imgElement.dataset.hqRequestId !== String(requestId)) return;

      const apply = () => {
        imgElement.src = highQualityUrl;
        imgElement.srcset = `${highQualityUrl} 1x`;
      };

      // A transition (open/close/slide) is in flight — defer the swap so a cache-fast resolve
      // can't pop/race mid-animation; settleAnimation() applies it once things settle.
      if (isAnimating) {
        pendingHq.set(imgElement, { imgElement, requestId, apply });
      } else if (element.id === "fullscreen") {
        apply();
      }
    };
    
    highQualityImg.onerror = () => {
      // src/srcset are only ever swapped on success (above), so a failed high-quality fetch
      // never breaks the thumbnail — it just keeps showing the original responsive image.
      console.warn('Failed to load high-quality image:', highQualityUrl);
    };
    
    // Start loading immediately
    highQualityImg.src = highQualityUrl;
  }

  function escapeFullscreen() {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen) return;

    if (isAnimating) {
      // Don't drop the request — run it once the in-flight open/slide animation settles.
      closeRequested = true;
      return;
    }

    zoomOut(fullscreen.querySelector(".resource"));
    disableFullscreenControls();
    fullscreen.removeAttribute("id");

    document.getElementById("fullscreen-controls").querySelectorAll("button").forEach((button) => button.blur());
  }

  // Called wherever an animation settles (isAnimating -> false) so a close requested mid-animation
  // still executes; a no-op if nothing was queued or fullscreen already closed by other means.
  function resolveQueuedClose() {
    if (!closeRequested) return;
    closeRequested = false;
    if (document.getElementById("fullscreen")) {
      escapeFullscreen();
    }
  }

  // Slides the outgoing (currently fullscreen) resource out while the incoming one slides in,
  // simultaneously, using a compositor-only transform (no `left`, no serial steps). Opacity is
  // never animated — the incoming resource stays fully offscreen until it moves, so there's no
  // overlap to crossfade, and a fixed opacity avoids the one-frame gap a fill:"forwards" opacity
  // effect can leave behind when it's cancelled at settle.
  function slideTo(targetElement, direction) {
    const fullscreen = document.getElementById("fullscreen");

    // Guards a missing/self target, e.g. a 0/1-image gallery with no valid neighbor.
    if (!fullscreen || isAnimating || !targetElement || targetElement === fullscreen) return;

    isAnimating = true;

    const outgoing = fullscreen.querySelector(".resource");
    const incoming = targetElement.querySelector(".resource");

    // Kick off the HQ fetch for the incoming resource now; the actual src swap is deferred (see
    // loadHighQualityImage) until this transition settles, so it can't pop mid-slide.
    loadHighQualityImage(targetElement, incoming);

    const enterX = direction === "next" ? "100%" : "-100%";
    const exitX = direction === "next" ? "-100%" : "100%";

    // Pre-stage incoming alongside the still-visible outgoing resource, fully off-screen.
    // Both get transition: none so only the WAAPI animate() calls below drive movement, and both
    // stay pinned at opacity 1 (never animated/toggled) so there's nothing to leave stale.
    outgoing.style.transition = "none";
    outgoing.style.opacity = "1";
    incoming.style.transition = "none";
    fullscreenResource(incoming);
    incoming.style.opacity = "1";
    incoming.style.transform = `translate3d(${enterX}, 0, 0)`;

    // Adjacent grid thumbnails are already loaded; start immediately instead of making keyboard
    // response wait on decode bookkeeping. The outgoing image remains visible throughout.
    const outAnim = outgoing.animate(
      [
        { transform: "translate3d(0, 0, 0)" },
        { transform: `translate3d(${exitX}, 0, 0)` },
      ],
      { duration: 200, easing: "ease-in-out", fill: "forwards" }
    );
    const inAnim = incoming.animate(
      [
        { transform: `translate3d(${enterX}, 0, 0)` },
        { transform: "translate3d(0, 0, 0)" },
      ],
      { duration: 200, easing: "ease-in-out", fill: "forwards" }
    );

    Promise.all([outAnim.finished, inAnim.finished])
      .catch(() => {}) // an aborted animation still needs the settle logic below to run
      .then(() => {
        outAnim.cancel();
        inAnim.cancel();

        // Restore the outgoing tile to its normal grid state (original src/srcset, no inline geometry).
        resetElement(outgoing);
        fullscreen.removeAttribute("id");

        // Atomically transfer fullscreen and give the incoming resource its final static geometry.
        targetElement.id = "fullscreen";
        incoming.style.transform = "";
        fullscreenResource(incoming);

        // Current tile becomes the focus-restore target for a later close.
        openerElement = targetElement;

        settleAnimation();
      });
  }

  function prevResource() {
    const fullscreen = document.getElementById("fullscreen");

    // A 0/1-image gallery has no valid neighbor to slide to.
    if (!fullscreen || galleryCount <= 1) return;

    // A transition is already running — coalesce to the latest direction instead of dropping it.
    if (isAnimating) {
      queuedDirection = "prev";
      return;
    }

    slideTo(
      fullscreen.dataset.position == "first"
        ? document.querySelector("[data-position='last']")
        : fullscreen.previousElementSibling,
      "prev"
    );
  }

  function nextResource() {
    const fullscreen = document.getElementById("fullscreen");

    // A 0/1-image gallery has no valid neighbor to slide to.
    if (!fullscreen || galleryCount <= 1) return;

    // A transition is already running — coalesce to the latest direction instead of dropping it.
    if (isAnimating) {
      queuedDirection = "next";
      return;
    }

    slideTo(
      fullscreen.dataset.position == "last"
        ? document.querySelector("[data-position='first']")
        : fullscreen.nextElementSibling,
      "next"
    );
  }

document.onkeydown = (event) => {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen) return;

    if (event.key == "Escape") {
    // Reaches escapeFullscreen even mid-animation so a close request gets queued, not dropped.
    escapeFullscreen();
    return;
    }

    if (event.key == "ArrowLeft" || event.key == "ArrowUp") {
    prevResource();
    } else if (event.key == "ArrowRight" || event.key == "ArrowDown") {
    nextResource();
    } else if (event.key == "Tab") {
    if (isAnimating) return;
    trapFullscreenFocus(event);
    }
};

// Keeps Tab/Shift+Tab cycling among the dialog's own buttons instead of escaping to the page
// behind it — the last button (close) wraps to the first (prev) and vice versa. Only buttons
// with tabindex enabled (i.e. controls currently visible) are ever reachable here.
function trapFullscreenFocus(event) {
    const controls = document.getElementById("fullscreen-controls");
    const buttons = controls.querySelectorAll("button:not([tabindex='-1'])");
    const first = buttons[0];
    const last = buttons[buttons.length - 1];
    if (!first) return;

    const withinControls = document.activeElement && controls.contains(document.activeElement);

    if (event.shiftKey) {
      if (!withinControls || document.activeElement === first) {
        event.preventDefault();
        last.focus();
      }
    } else if (!withinControls || document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
}

function zoomIn(element) {
  element.style.transition = "opacity 200ms ease-in-out";
  element.style.opacity = "0";
  element.style.position = "fixed";
  element.style.zIndex = "2";
  element.style.inset = "0";
  element.style.width = "100vw";
  element.style.height = "100vh";
  element.style.objectFit = "contain";
  isAnimating = true;
  // rAF flushes the styles above before the opacity transition, without a forced-reflow read.
  requestAnimationFrame(() => {
    element.style.opacity = "1";
  });
  setTimeout(() => {
    fullscreenResource(element);
    settleAnimation();
  }, 200);
}

function zoomOut(element) {
  isAnimating = true;
  element.style.transition = "opacity 200ms ease-in-out";
  element.style.opacity = "0";
  setTimeout(() => {
    resetElement(element);
    enableScrolling();
    element.style.transition = "none";
    element.style.opacity = "1";

    // Restored only now (not immediately in escapeFullscreen) — doing it earlier let a rapid
    // reopen fire mid-animation and get torn down when this timer's cleanup ran. preventScroll
    // avoids yanking the viewport back to a tile that slid out of view during navigation.
    if (openerElement) {
      openerElement.focus({ preventScroll: true });
      openerElement = null;
    }
    settleAnimation();
  }, 200);
}

function fullscreenResource(element) {
  element.style.width = "100vw";
  element.style.height = "100vh";
  element.style.objectFit = "contain";
  element.style.inset = "0";
  element.style.zIndex = "2";
  element.style.position = "fixed";
}

function resetElement(element) {
    element.style.removeProperty("transition");
    element.style.removeProperty("width");
    element.style.removeProperty("height");
    element.style.removeProperty("top");
    element.style.removeProperty("position");
    element.style.removeProperty("z-index");
    element.style.removeProperty("margin-left");
    element.style.removeProperty("margin-top");
    element.style.removeProperty("inset");
    element.style.removeProperty("object-fit");

    // Invalidate any in-flight high-quality request so its onload can't swap into this tile later.
    delete element.dataset.hqRequestId;

    // Restore the responsive grid candidate after the fullscreen geometry is removed.
    if (element.dataset.originalSrc) {
      element.src = element.dataset.originalSrc;
      element.srcset = element.dataset.originalSrcset;
    }
}

function disableScrolling() {
    const bodyWidthBefore = document.body.clientWidth;
    document.body.classList.add("overflow-hidden");
    // Deferred to rAF so this reflow-triggering read doesn't stack with zoomIn's writes in the same tick.
    requestAnimationFrame(() => {
      if (bodyWidthBefore < document.body.clientWidth) {
        document.body.classList.add("mr-4");
      }
    });
}

function enableScrolling() {
    document.body.classList.remove("overflow-hidden");
    document.body.classList.remove("mr-4");
}

function enableFullscreenControls() {
    const controls = document.getElementById("fullscreen-controls");
    controls.style.opacity = 1;
    controls.setAttribute("aria-hidden", "false");
    controls.querySelectorAll("button").forEach((button) => {
    button.style.pointerEvents = "auto";
    button.removeAttribute("tabindex");
    });
    const backdrop = document.getElementById("fullscreen-backdrop");
    backdrop.style.opacity = 1;
    backdrop.style.pointerEvents = "auto";
}

function disableFullscreenControls() {
    const controls = document.getElementById("fullscreen-controls");
    // Blur first — aria-hidden must never be applied to a subtree that still holds focus.
    controls.querySelectorAll("button").forEach((button) => button.blur());
    controls.style.opacity = 0;
    controls.setAttribute("aria-hidden", "true");
    // tabindex="-1" keeps Tab from reaching these while hidden, backing the focus trap.
    controls.querySelectorAll("button").forEach((button) => {
    button.style.pointerEvents = "none";
    button.setAttribute("tabindex", "-1");
    });
    const backdrop = document.getElementById("fullscreen-backdrop");
    backdrop.style.opacity = 0;
    backdrop.style.pointerEvents = "none";
}

const threshold = 50;
let isScrolling = false;
let startX;
let endX;
let startY;
let endY;

document.addEventListener("touchstart", (e) => {
    isScrolling = false;
    startX = e.changedTouches[0].screenX;
    startY = e.changedTouches[0].screenY;
}, { passive: true });

document.addEventListener("touchmove", () => {
    isScrolling = true;
}, { passive: true });

document.addEventListener("touchend", (e) => {
    endX = e.changedTouches[0].screenX;
    endY = e.changedTouches[0].screenY;
    const fullscreen = document.getElementById("fullscreen");
    if (!fullscreen || isAnimating) {
    return;
    }
    if (Math.abs(startX - endX) < threshold && Math.abs(startY - endY) < threshold) {
    return;
    }
    if (Math.abs(startY - endY) > threshold) {
    escapeFullscreen();
    return;
    }
    if (endX < startX) nextResource();
    else if (endX > startX) prevResource();
});

// Delegated equivalents of the removed per-tile onkeydown/ontouchend attributes — event.target
// is properly typed here (unlike the implicit global `event` in an inline handler attribute).
galleryWrapper?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    if (!(event.target instanceof Element)) return;
    const tile = event.target.closest("[data-public-id]");
    if (!tile) return;
    event.preventDefault();
    setFullscreen(tile);
});

galleryWrapper?.addEventListener("touchend", (event) => {
    if (isScrolling) return;
    if (!(event.target instanceof Element)) return;
    const tile = event.target.closest("[data-public-id]");
    if (!tile) return;
    setFullscreen(tile);
});

document.addEventListener("DOMContentLoaded", () => {
  // Consolidated from two previously-redundant reveal mechanisms (a DOMContentLoaded pass and a
  // separate IntersectionObserver) that both just flipped opacity on load.
  const reveal = (img) => {
    if (img.complete) {
      img.style.opacity = "1";
      return;
    }
    // Reveal on error too — otherwise a failed lazy image stays opacity:0 forever, hiding the
    // broken-image icon/alt text a user needs to see.
    const show = () => { img.style.opacity = "1"; };
    img.addEventListener("load", show, { once: true });
    img.addEventListener("error", show, { once: true });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        reveal(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { rootMargin: "200px" });

  document.querySelectorAll(".resource").forEach((img) => observer.observe(img));
});
</script>