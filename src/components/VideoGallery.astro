    if (!video) return;
    if (video.paused) {
      if (isFullscreenVideo(video)) setFullscreenLoading(video, true);
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === "function") {
        playPromise.catch(() => {
          if (isFullscreenVideo(video)) {
            if (video.error) setFullscreenError(video);
            else setFullscreenLoading(video, false);
          }
        });
      }
    } else {
      video.pause();
    }
  }
</script>