---
import SocialIcons from './SocialIcons.astro';
---

<footer class="footer">
  <div class="footer-content">
    <SocialIcons />
  </div>
</footer>

<style>
  .footer {
    background-color: rgb(23,23,23);
    color: #ffffff;
    padding: 1rem 20px;
    border-top: 1px solid #333;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Override header-icons display:none on mobile */
  .footer :global(.header-icons) {
    display: flex !important;
  }
</style>
