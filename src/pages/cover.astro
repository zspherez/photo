---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="Josh Rehders — Photographer and Videographer"
  description="Josh Rehders is a photographer and videographer based in New York City, with a focus on capturing electronic music events."
>

  <main>  
    <Header />
    <div class="about-container">
      <object
        data="/rehders_cover.pdf"
        type="application/pdf"
        width="80%"
        height="800px"
      >
        <p>Your browser doesn't support PDF embedding. <a href="/rehders_cover.pdf">Download the cover letter</a> instead.</p>
      </object>
    </div>
  </main>

</Layout>