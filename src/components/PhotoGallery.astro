---
import { v2 as cloudinary } from "cloudinary";
import { CldImage } from 'astro-cloudinary';
import left from '../icons/chevron-left-solid.svg?raw'
import right from '../icons/chevron-right-solid.svg?raw'
import Icon from '../components/Icon.astro'

export interface Props {
  folder: string;
  filter?: string;
}

export interface CloudinaryResource {
  secure_url: string;
  public_id: string;
  width: number;
  height: number;
  aspect_ratio: number;
  context: { alt: string };
}

cloudinary.config({
  cloud_name: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME,
  api_key: import.meta.env.PUBLIC_CLOUDINARY_API_KEY,
  api_secret: import.meta.env.SECRET_CLOUDINARY_API_KEY,
  secure: true,
});

// Only fetch images (no videos)
const search = await cloudinary.search
  .expression(`folder:${Astro.props.folder} AND resource_type:image`)
  .with_field("context")
  .sort_by("display_name", "asc")
  .max_results(500)
  .execute();

const filteredResources = search.resources as CloudinaryResource[];
---

<div class="flex flex-wrap m-0.5">

  {filteredResources.map((CloudinaryResource, index) => (
    <div
      data-position={`${index == 0 ? "first" : index + 1 == filteredResources.length ? "last" : "middle"}`}
      data-public-id={CloudinaryResource.public_id}
      data-width={CloudinaryResource.width}
      data-height={CloudinaryResource.height}
      data-alt={CloudinaryResource.context?.alt || ""}
      onclick="setFullscreen(this)"
      ontouchend="if (!isScrolling) setFullscreen(this)"
      class="relative m-0.5 cursor-zoom-in fullscreen:cursor-auto"
      style={`flex-grow: ${CloudinaryResource.width * 400 / CloudinaryResource.height}; flex-basis: ${CloudinaryResource.width * 400 / CloudinaryResource.height}px;`}
    >

      <!-- placeholder for proper grid sizing -->
      <div class="block" style={`padding-bottom: ${CloudinaryResource.height / CloudinaryResource.width * 100}%`}></div>

      <CldImage
        src={CloudinaryResource.public_id}
        width={CloudinaryResource.width}
        height={CloudinaryResource.height}
        alt={CloudinaryResource.context?.alt || ""}
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
        class="resource absolute align-bottom top-0 w-full h-full object-cover opacity-0 transition-opacity ease-in duration-1000 fullscreen:pointer-events-none"
        crop={{
          type: 'fill',
          source: true
        }}
        loading={`${index <= 10 ? "eager" : "lazy"}`}
      />
    </div>
  ))}

</div>

<div id="fullscreen-backdrop" class="fixed scale-200 inset-0 z-[1] w-screen h-screen bg-black pointer-events-none opacity-0 transition-opacity duration-200"></div>

<div id="fullscreen-controls" class="fixed top-0 z-[3] w-screen h-screen pointer-events-none opacity-0 transition-opacity duration-200">
  <button type="button" onclick="prevResource()" class="fixed left-0 mt-[25vh] flex h-[50vh] w-[15vw] items-center opacity-0 hover:opacity-100 md:w-[25vw]">
    <div class="absolute left-0 ml-4 rounded-full bg-neutral-700 p-2 md:ml-8 md:p-4">
       <Icon name="left" />
      <span class="sr-only">previous image</span>
    </div>
  </button>

  <button type="button" onclick="nextResource()" class="fixed right-0 mt-[25vh] flex h-[50vh] w-[15vw] items-center opacity-0 hover:opacity-100 md:w-[25vw]">
    <div class="absolute right-0 mr-4 rounded-full bg-neutral-700 p-2 md:mr-8 md:p-4">
      <Icon name="right" />
      <span class="sr-only">next image</span>
    </div>
  </button>

  <button type="button" onclick="escapeFullscreen(true)" class="fixed ml-2 mt-2 rounded-full bg-neutral-700/50 p-3 hover:bg-neutral-700">
    <Icon name="x" />
    <span class="sr-only">exit image</span>
  </button>
</div>

<script is:inline>
  let isAnimating = false;

  function setFullscreen(element, animation) {
    if (element.id == "fullscreen") {
      return;
    }

    // Start loading high-quality image immediately
    const resource = element.querySelector(".resource");
    loadHighQualityImage(element, resource);

    disableScrolling();
    enableFullscreenControls();
    element.id = "fullscreen";
    
    if (animation) {
      isAnimating = true;

      resource.classList.add(animation);
      fullscreenResource(resource)

      setTimeout(() => {
        resource.classList.remove(animation);
        isAnimating = false;
      }, 200);
    } else {
      zoomIn(resource);
    }
  }

  function loadHighQualityImage(element, imgElement) {
    const publicId = element.dataset.publicId;
    
    if (!publicId || !imgElement) return;

    // Extract cloud name from existing image src
    let cloudName = null;
    const existingSrc = imgElement.src || imgElement.getAttribute('src');
    if (existingSrc) {
      const match = existingSrc.match(/res\.cloudinary\.com\/([^\/]+)\//);
      if (match) {
        cloudName = match[1];
      }
    }
    
    // Fallback if we can't extract cloud name
    if (!cloudName) {
      console.warn('Could not extract Cloudinary cloud name, skipping high-quality load');
      return;
    }

    // Use screen dimensions for optimal fullscreen quality
    const screenWidth = window.innerWidth;
    const screenHeight = window.innerHeight;
    const devicePixelRatio = window.devicePixelRatio || 1;
    
    // Calculate target dimensions (account for device pixel ratio)
    const targetWidth = Math.ceil(screenWidth * devicePixelRatio);
    const targetHeight = Math.ceil(screenHeight * devicePixelRatio);
    
    // Create high-quality Cloudinary URL optimized for fullscreen viewing
    const highQualityUrl = `https://res.cloudinary.com/${cloudName}/image/upload/c_fit,w_${targetWidth},h_${targetHeight},q_auto:good,f_auto/${publicId}`;
    
    // Preload the high-quality image
    const highQualityImg = new Image();
    highQualityImg.onload = () => {
      // Update the existing image with high-quality version
      if (imgElement.tagName === 'IMG') {
        imgElement.src = highQualityUrl;
        if (imgElement.srcset) {
          imgElement.srcset = `${highQualityUrl} 1x`;
        }
      }
    };
    
    highQualityImg.onerror = () => {
      console.warn('Failed to load high-quality image:', highQualityUrl);
    };
    
    // Start loading immediately
    highQualityImg.src = highQualityUrl;
  }

  function escapeFullscreen(close) {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen || isAnimating) return;

    if (close) {
      zoomOut(fullscreen.querySelector(".resource"));
      disableFullscreenControls();
    } else {
      resetElement(fullscreen.querySelector(".resource"))
    }
    
    fullscreen.removeAttribute("id");

    document.getElementById("fullscreen-controls").querySelectorAll("button").forEach((button) => button.blur());
  }

  function slideTo(element, animationOut, animationIn) {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen || isAnimating) return;

    const resource = fullscreen.querySelector(".resource");
    resource.classList.add(animationOut);

    isAnimating = true;

    setTimeout(() => {
      resource.classList.remove(animationOut);

      isAnimating = false;

      escapeFullscreen(false);
      setFullscreen(element, animationIn);
    }, 200);
  }

  function prevResource() {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen || isAnimating) return;

    slideTo(
      fullscreen.dataset.position == "first"
        ? document.querySelector("[data-position='last']")
        : fullscreen.previousSibling,
      "animate-slide-out-right",
      "animate-slide-in-left"
    );
  }

function nextResource() {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen || isAnimating) return;

    slideTo(
    fullscreen.dataset.position == "last"
        ? document.querySelector("[data-position='first']")
        : fullscreen.nextSibling,
    "animate-slide-out-left",
    "animate-slide-in-right"
    );
}

document.onkeydown = (event) => {
    const fullscreen = document.getElementById("fullscreen");

    if (!fullscreen || isAnimating) return;

    if (event.key == "Escape") {
    escapeFullscreen(true);
    } else if (event.key == "ArrowLeft" || event.key == "ArrowUp") {
    prevResource();
    } else if (event.key == "ArrowRight" || event.key == "ArrowDown") {
    nextResource();
    }
};

function zoomIn(element) {
  const rect = element.getBoundingClientRect();
  element.style.transition = "opacity 200ms ease-in-out";
  element.style.opacity = "0";
  element.style.position = "fixed";
  element.style.zIndex = "2";
  element.style.inset = "0";
  element.style.width = "100vw";
  element.style.height = "100vh";
  element.style.objectFit = "contain";
  element.getBoundingClientRect();
  isAnimating = true;
  element.style.opacity = "1";
  setTimeout(() => {
    fullscreenResource(element);
    isAnimating = false;
  }, 200);
}

function zoomOut(element) {
  isAnimating = true;
  element.style.transition = "opacity 200ms ease-in-out";
  element.style.opacity = "0";
  setTimeout(() => {
    resetElement(element);
    enableScrolling();
    isAnimating = false;
    element.style.transition = "none";
    element.style.opacity = "1";
  }, 200);
}

function fullscreenResource(element) {
  element.style.width = "100vw";
  element.style.height = "100vh";
  element.style.objectFit = "contain";
  element.style.inset = "0";
  element.style.zIndex = "2";
  element.style.position = "fixed";
}

function resetElement(element) {
    element.style.removeProperty("transition");
    element.style.removeProperty("width");
    element.style.removeProperty("height");
    element.style.removeProperty("top");
    element.style.removeProperty("position");
    element.style.removeProperty("z-index");
    element.style.removeProperty("margin-left");
    element.style.removeProperty("margin-top");
    element.style.removeProperty("inset");
    element.style.removeProperty("object-fit");
}

function disableScrolling() {
    const bodyWidthBefore = document.body.clientWidth;
    document.body.classList.add("overflow-hidden");
    if (bodyWidthBefore < document.body.clientWidth) {
    document.body.classList.add("mr-4");
    }
}

function enableScrolling() {
    document.body.classList.remove("overflow-hidden");
    document.body.classList.remove("mr-4");
}

function enableFullscreenControls() {
    const controls = document.getElementById("fullscreen-controls");
    controls.style.opacity = 1;
    controls.querySelectorAll("button").forEach((button) => {
    button.style.pointerEvents = "auto";
    });
    const backdrop = document.getElementById("fullscreen-backdrop");
    backdrop.style.opacity = 1;
    backdrop.style.pointerEvents = "auto";
}

function disableFullscreenControls() {
    const controls = document.getElementById("fullscreen-controls");
    controls.style.opacity = 0;
    controls.querySelectorAll("button").forEach((button) => {
    button.style.pointerEvents = "none";
    });
    const backdrop = document.getElementById("fullscreen-backdrop");
    backdrop.style.opacity = 0;
    backdrop.style.pointerEvents = "none";
}

const threshold = 50;
let isScrolling = false;
let startX;
let endX;
let startY;
let endY;

document.addEventListener("touchstart", (e) => {
    isScrolling = false;
    startX = e.changedTouches[0].screenX;
    startY = e.changedTouches[0].screenY;
}, { passive: true });

document.addEventListener("touchmove", (e) => {
    isScrolling = true;
}, { passive: true });

document.addEventListener("touchend", (e) => {
    endX = e.changedTouches[0].screenX;
    endY = e.changedTouches[0].screenY;
    const fullscreen = document.getElementById("fullscreen");
    if (!fullscreen || isAnimating) {
    return;
    }
    if (Math.abs(startX - endX) < threshold && Math.abs(startY - endY) < threshold) {
    return;
    }
    if (Math.abs(startY - endY) > threshold) {
    escapeFullscreen(true);
    return;
    }
    if (endX < startX) nextResource();
    else if (endX > startX) prevResource();
});

document.addEventListener("DOMContentLoaded", () => {
  const resources = document.querySelectorAll(".resource");
  resources.forEach((resource) => {
    if (resource.complete) {
      resource.style.opacity = "1";
    } else {
      resource.addEventListener("load", () => {
        resource.style.opacity = "1";
      });
    }
  });
});

const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      const img = entry.target;
      if (img.complete) {
        img.style.opacity = "1";
      } else {
        img.addEventListener("load", () => {
          img.style.opacity = "1";
        });
      }
      observer.unobserve(img);
    }
  });
}, {
  rootMargin: "200px"
});

document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".resource").forEach((img) => {
    observer.observe(img);
  });
});
</script>