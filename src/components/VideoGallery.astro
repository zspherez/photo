<!-- handle updating the current time of the video playing when fullscreen -->
<!-- is:inline: keeps these functions global so inline on* attributes can call them -->
<script is:inline>
  const videos = document.querySelectorAll("video");

  // True when this video is the one currently shown in the fullscreen viewer.
  function isFullscreenVideo(video) {
    const tile = video.parentElement && video.parentElement.parentElement;
    return !!tile && tile.id === "fullscreen";
  }

  function updatePlayButtonUI(video) {
    const btn = document.getElementById("fullscreen-play-btn");
    if (!btn) return;
    const playing = !video.paused;
    const pauseIcon = btn.querySelector('[data-icon="pause"]');
    const playIcon = btn.querySelector('[data-icon="play"]');
    if (pauseIcon) pauseIcon.classList.toggle("hidden", !playing);
    if (playIcon) playIcon.classList.toggle("hidden", playing);
    btn.setAttribute("aria-label", playing ? "Pause video" : "Play video");
  }

  function updateMuteButtonUI(video) {
    const btn = document.getElementById("fullscreen-mute-btn");
    if (!btn) return;
    const muted = video.muted;
    const volumeIcon = btn.querySelector('[data-icon="volume"]');
    const mutedIcon = btn.querySelector('[data-icon="muted"]');
    if (volumeIcon) volumeIcon.classList.toggle("hidden", muted);
    if (mutedIcon) mutedIcon.classList.toggle("hidden", !muted);
    btn.setAttribute("aria-label", muted ? "Unmute video" : "Mute video");
  }

  function setFullscreenLoading(video, visible) {
    const tile = video.closest("[data-position]");
    const indicator = tile && tile.querySelector('[role="status"]');
    if (!indicator) return;
    const spinner = indicator.querySelector("[data-video-spinner]");
    const error = indicator.querySelector("[data-video-error]");
    const statusText = indicator.querySelector("[data-video-status-text]");
    spinner?.classList.toggle("hidden", !visible);
    if (visible) error?.classList.add("hidden");
    if (statusText) statusText.textContent = visible ? "Loading video..." : "";
    indicator.style.display = visible ? "block" : "none";
  }

  function setFullscreenError(video) {
    const tile = video.closest("[data-position]");
    const indicator = tile && tile.querySelector('[role="status"]');
    if (!indicator) return;
    indicator.querySelector("[data-video-spinner]")?.classList.add("hidden");
    indicator.querySelector("[data-video-error]")?.classList.remove("hidden");
    const statusText = indicator.querySelector("[data-video-status-text]");
    if (statusText) statusText.textContent = "Video unavailable";
    indicator.style.display = "block";
  }

  function resetVideoTimeDisplay(video) {
    const span = document.getElementById(`current-time-${video.id}`);
    if (span) span.textContent = "0:00 / ";
  }

  function commitFullscreenFrame(video) {
    if (
      !isFullscreenVideo(video)
      || video.paused
      || video.readyState < 2
    ) {
      return;
    }
    video.muted = fullscreenMuted;
    video.removeAttribute("poster");
    setFullscreenLoading(video, false);
    updateMuteButtonUI(video);
  }

  videos.forEach((video) => {
    // Covers every playback path (autoplay, click, Space, pause) via native events.
    video.addEventListener("play", () => {
      if (isFullscreenVideo(video)) updatePlayButtonUI(video);
    });
    video.addEventListener("pause", () => {
      if (isFullscreenVideo(video)) {
        updatePlayButtonUI(video);
        setFullscreenLoading(video, false);
      }
    });
    video.addEventListener("volumechange", () => {
      if (isFullscreenVideo(video)) updateMuteButtonUI(video);
    });
    // Deferred-poster fallback: if a frame renders after the open gate already settled
    // (e.g. autoplay was rejected, user pressed play once buffered), drop the stale poster.
    // Still gated on readyState so this can never strip the poster ahead of a real frame.
    video.addEventListener("playing", () => {
      commitFullscreenFrame(video);
    });
    video.addEventListener("waiting", () => {
      if (isFullscreenVideo(video) && !video.paused) setFullscreenLoading(video, true);
    });
    video.addEventListener("stalled", () => {
      if (isFullscreenVideo(video) && !video.paused) setFullscreenLoading(video, true);
    });
    video.addEventListener("error", () => {
      const tile = video.closest("[data-position]");
      if (isFullscreenVideo(video) || tile?.getAttribute("data-opening") === "true") {
        setFullscreenError(video);
        updatePlayButtonUI(video);
      }
    });

    const videoId = video.id;
    const currentTimeSpan = document.getElementById(`current-time-${videoId}`);
    if (!currentTimeSpan) return;

    // Native event: fires only while actually playing, no per-video timer needed.
    video.addEventListener("timeupdate", () => {
      commitFullscreenFrame(video);
      const minutes = Math.floor(video.currentTime / 60);
      const seconds = Math.floor(video.currentTime % 60);
      currentTimeSpan.innerHTML = `${minutes}:${seconds.toString().padStart(2, "0")} / `;
    });
    
  });
  
  // Muted so hover (not a real gesture) can autoplay; metadata-only preload for a light fetch.
  function previewVideo(video) {
    if (document.getElementById("fullscreen") || pendingOpen) return;

    video.muted = true;
    if (video.preload !== "auto") {
      video.preload = "metadata";
    }

    const playPromise = video.play();
    if (playPromise && typeof playPromise.catch === "function") {
      playPromise.catch(() => {}); // ignore expected rejections (e.g. rapid mouseout)
    }
  }
  
  function resetVideo(video) {
    if (document.getElementById("fullscreen") || pendingOpen) return;

    video.pause();
    video.currentTime = 0;
    resetVideoTimeDisplay(video);
    video.muted = false;
    video.preload = "none";
