---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Gallery from "../components/Gallery.astro";
---

<Layout
  title="Josh Rehders — Concert and Sports Photographer & Videographer"
  description="Josh Rehders is a concert and sports photographer & videographer based in New York City."
>

  <main>  
    <Header />
    <div class="about-container">
      <iframe
        src="https://drive.google.com/file/d/16DMzyJU7TGAjBLC9cZ1LuOZLS84Tw_0m/preview"
        width="80%"
        height="800px"
        allow="autoplay"
        loading="lazy"
        title="Resume"
        style="border: none;"
        sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
      ></iframe>
    </div>
  </main>

</Layout>