---
import Layout from "../../layouts/Layout.astro";
import GalleryManager from "../../components/GalleryManager.astro";
import { verifyAccess } from "../../lib/auth";

export const prerender = false;

const runtime = (Astro.locals as any)?.runtime?.env as
  | CloudflareEnv
  | undefined;
let available = Boolean(runtime?.ORIGINALS && runtime?.MEDIA);
let authed = false;
let errorMessage = "";

if (available && runtime) {
  try {
    authed = Boolean(await verifyAccess(Astro.request, runtime as any));
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : String(error);
  }
}
---

<Layout
  title="Gallery Manager"
  description="Manage portfolio galleries."
  hidden={true}
>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl font-semibold">Gallery Manager</h1>
    {!available && (
      <p class="mt-4 text-amber-300">
        Gallery R2 bindings are not configured on this deployment.
      </p>
    )}
    {available && !authed && (
      <p class="mt-4 text-red-400">
        Not authenticated. Open this page through Cloudflare Access.
        {errorMessage && (
          <span class="mt-1 block text-neutral-500">{errorMessage}</span>
        )}
      </p>
    )}
    {available && authed && <GalleryManager />}
  </main>
</Layout>
